---
/**
 * The quiet secondary action: "Llámanos" with the phone number beside it, as an underlined text link.
 */
interface Props {
  label: string;
  phone: string;
  href: string;
  tone?: 'ink' | 'paper';
}
const { label, phone, href, tone = 'ink' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex min-h-12 items-center gap-2 text-base underline decoration-1 underline-offset-4 transition-colors duration-(--duration-fast)',
    tone === 'paper'
      ? 'text-primary-contrast hover:decoration-2'
      : 'text-ink hover:text-primary',
  ]}
>
  <span class="font-semibold">{label}</span>
  <span class="tabular-nums">{phone}</span>
</a>
