---
// The one section of direction "a": a sticky split. Explanatory blocks scroll on the left while the calculator
// panel stays in place on the right (CSS position: sticky from 1024 px; stacked and static below).
import ActionPair from './ActionPair.astro';
import CalculatorPanel from './CalculatorPanel.astro';
import TwoTone from './TwoTone.astro';
import { calculator } from './copy';
---

<section id="a-calculadora" class="px-4 sm:px-6" aria-labelledby="a-calc-title">
  <div class="border-line mx-auto max-w-6xl border-x px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
    <p class="text-primary text-sm font-medium">{calculator.eyebrow}</p>
    <h2
      id="a-calc-title"
      class="font-display mt-4 max-w-3xl text-2xl leading-tight font-light tracking-tight text-balance"
    >
      <TwoTone lead={calculator.lead} rest={calculator.rest} />
    </h2>

    <div class="mt-14 grid gap-10 lg:grid-cols-[3fr_2fr] lg:items-start lg:gap-16">
      <ol class="border-line border-t">
        {calculator.blocks.map((block, index) => (
          <li class="border-line grid gap-3 border-b py-10 sm:grid-cols-[4rem_1fr] lg:py-16">
            <span
              aria-hidden="true"
              class="text-primary text-sm font-medium tabular-nums"
            >
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="font-display text-xl font-normal tracking-tight">
                {block.title}
              </h3>
              <p class="text-ink-soft mt-3 max-w-prose leading-relaxed">
                {block.body}
              </p>
            </div>
          </li>
        ))}
      </ol>
      <div class="lg:sticky lg:top-8">
        <CalculatorPanel />
      </div>
    </div>

    <div class="bg-surface border-line mt-16 flex flex-col gap-6 rounded-lg border p-6 sm:p-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-xl">
        <h3 class="font-display text-xl font-normal tracking-tight">
          {calculator.closingTitle}
        </h3>
        <p class="text-ink-soft mt-2 leading-relaxed">
          {calculator.closingBody}
        </p>
      </div>
      <ActionPair />
    </div>
  </div>
</section>
