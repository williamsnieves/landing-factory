---
// Header of direction "a": the draft and sample notices in a slim bar, then the wordmark and the primary action.
import { site } from '../../../content/site';
import { header } from './copy';
---

<div class="bg-surface text-ink-soft border-line border-b px-4 sm:px-6">
  <div class="border-line mx-auto max-w-6xl border-x px-5 py-2 sm:px-8 lg:px-12">
    <p class="text-xs leading-snug">
      <strong class="text-ink font-medium">{site.draftNotice}</strong>
      <span class="block sm:inline"> {site.sampleNotice}</span>
    </p>
  </div>
</div>
<header class="border-line border-b px-4 sm:px-6">
  <div class="border-line mx-auto flex max-w-6xl items-center justify-between gap-4 border-x px-5 py-4 sm:px-8 lg:px-12">
    <p class="flex min-w-0 flex-col leading-tight">
      <span class="font-display text-lg font-medium tracking-tight">
        {site.name}
      </span>
      <span class="text-ink-soft hidden text-xs sm:block">
        {header.tagline}
      </span>
    </p>
    <a
      href={site.primary.href}
      class="bg-primary text-primary-contrast rounded-pill shrink-0 px-4 py-2 text-sm font-medium transition-opacity hover:opacity-90"
    >
      {header.cta}
    </a>
  </div>
</header>
