---
// Services section of direction "c": the three services from the brief as warm, readable rows (only the
// valuation carries a price: "Gratis"), beside the service area and an hours card (sample data), then the
// primary action and the call link once more.
import { site } from '../../../content/site';
import SampleTag from './SampleTag.astro';
import { services } from './copy';
---

<section id="c-servicios" class="bg-surface px-4 py-14 sm:px-6 md:py-20">
  <div class="mx-auto max-w-6xl">
    <p class="text-ink-soft text-sm font-bold">{services.eyebrow}</p>
    <h2 class="font-display mt-2 text-3xl leading-tight text-balance">
      {services.title}
    </h2>
    <p class="text-ink-soft mt-3 max-w-2xl text-lg">{services.line}</p>

    <div class="mt-10 grid gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-8">
      <ol class="grid gap-4">
        {site.offers.map((offer, index) => (
          <li class="bg-paper flex gap-4 rounded-lg p-5 sm:gap-6 sm:p-7">
            <span
              class="border-accent text-ink font-display flex size-10 shrink-0 items-center justify-center rounded-full border-2 text-lg"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                <h3 class="font-display text-xl leading-snug">{offer.name}</h3>
                {offer.price && (
                  <span class="bg-primary text-primary-contrast rounded-sm px-2.5 py-0.5 text-sm font-bold">
                    {offer.price}
                  </span>
                )}
              </div>
              <p class="text-ink-soft mt-2 text-base leading-relaxed">
                {offer.description}
              </p>
            </div>
          </li>
        ))}
      </ol>

      <div class="grid content-start gap-4">
        <div class="bg-paper rounded-lg p-5 sm:p-7">
          <h3 class="font-display text-xl">{services.areaTitle}</h3>
          <p class="text-ink-soft mt-2 text-base">{services.areaLine}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {site.serviceArea.map((place) => (
              <li class="border-primary text-primary rounded-full border px-3 py-1 text-sm font-bold">
                {place}
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-paper border-accent rounded-lg border-l-4 p-5 sm:p-7">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 class="font-display text-xl">{services.hoursTitle}</h3>
            <SampleTag />
          </div>
          <p class="mt-3 text-lg leading-snug font-semibold">
            {site.contact.hours}
          </p>
          <p class="text-ink-soft mt-3 text-base">{site.contact.address}</p>
        </div>
      </div>
    </div>

    <div class="bg-paper mt-10 flex flex-col gap-5 rounded-lg p-6 sm:p-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="lg:min-w-0 lg:flex-1">
        <h3 class="font-display text-2xl leading-tight">
          {services.closingTitle}
        </h3>
        <p class="text-ink-soft mt-2 text-base">{services.closingLine}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center lg:shrink-0">
        <a
          href={site.primary.href}
          class="bg-primary text-primary-contrast hover:bg-ink rounded-md px-5 py-3.5 text-center text-base font-bold transition-colors"
        >
          {site.primary.label}
        </a>
        <p class="text-sm">
          {services.callPrefix}{' '}
          <a
            href={site.secondary.href}
            class="font-bold whitespace-nowrap underline underline-offset-4 hover:no-underline"
          >
            {site.contact.phone}
          </a>{' '}
          <span class="text-ink-soft">(ejemplo)</span>
        </p>
      </div>
    </div>
  </div>
</section>
