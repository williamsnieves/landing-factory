---
/**
 * La primera visita (PAS: Solution). 4 + 8: the heading on the left, a real ordered list of what the first
 * assessment includes on the right (from offer[0].description), with the primary action under it (mid-page).
 */
import SectionHead from '../ui/SectionHead.astro';
import ActionLink from '../ui/ActionLink.astro';
import PhoneLink from '../ui/PhoneLink.astro';
import {
  contact,
  firstVisit,
  primaryAction,
  secondaryAction,
} from '../../data/site';
---

<section
  id="primera-visita"
  aria-labelledby="primera-visita-titulo"
  class="border-line border-t py-16 md:py-24"
>
  <div class="wrap grid-12 gap-y-8">
    <div class="col-span-12 md:col-span-4">
      <SectionHead
        id="primera-visita-titulo"
        heading={firstVisit.heading}
        intro={firstVisit.intro}
      />
    </div>
    <div class="col-span-12 md:col-span-8">
      <ol class="border-line border-b">
        {firstVisit.steps.map((step, index) => (
          <li
            class="border-line grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-4 border-t py-6"
            data-reveal
            data-reveal-y="16"
            data-reveal-delay={String(index * 0.08)}
          >
            <span
              class="text-primary text-lg font-semibold tabular-nums"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <div>
              <h3 class="text-lg leading-snug font-semibold">{step.title}</h3>
              <p class="mt-1 max-w-[56ch] text-base">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <div
        class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3"
        data-reveal
      >
        <ActionLink href={primaryAction.href} label={primaryAction.label} />
        <PhoneLink
          label={secondaryAction.label}
          phone={contact.phone}
          href={secondaryAction.href}
        />
      </div>
    </div>
  </div>
</section>
