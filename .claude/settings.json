{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "OPENSPEC_TELEMETRY": "0"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npx astro *)",
      "Bash(npx impeccable *)",
      "Bash(npx playwright *)",
      "Bash(npx prettier *)",
      "Bash(openspec *)",
      "Bash(bash scripts/setup-agent.sh *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(npx impeccable@4.6.0 *)",
      "Bash(QA_CHROME_PATH=* npm run qa *)",
      "Bash(npm install)",
      "Bash(npm install --no-audit --no-fund)",
      "Bash(npm install -w site-* @fontsource-variable/*)",
      "Bash(npm install -w site-* @fontsource/*)",
      "Bash(npm install --no-audit --no-fund -w site-* @fontsource/*)",
      "Bash(npm install --no-audit --no-fund -w site-* @fontsource-variable/*)",
      "Bash(npm view *)",
      "Bash(node scripts/preflight.mjs *)",
      "Bash(node scripts/brief.mjs *)",
      "Bash(node scripts/directions.mjs *)",
      "Bash(node scripts/find-images.mjs *)",
      "Bash(node scripts/ai-images.mjs *)",
      "Bash(node scripts/credits.mjs *)",
      "Bash(node scripts/legal.mjs *)",
      "Bash(node scripts/check-landing.mjs *)",
      "Bash(node scripts/landing-report.mjs *)",
      "Bash(node scripts/render-poster.mjs *)",
      "Bash(node scripts/pick-archetypes.mjs *)",
      "Bash(node scripts/pick-copy-framework.mjs *)",
      "Bash(node scripts/layout-signature.mjs *)",
      "Bash(node scripts/site-layers.mjs *)",
      "Bash(node scripts/handoff.mjs *)",
      "Bash(node scripts/validate-archetypes.mjs *)",
      "Bash(python3 .claude/skills/ui-ux-pro-max/scripts/search.py *)",
      "Bash(node .claude/skills/design-taste-frontend/scripts/*)",
      "Bash(date *)",
      "Bash(node scripts/section-shots.mjs *)",
      "Bash(node scripts/deploy.mjs --site * --dry-run)",
      "mcp__landing-factory__list_landings",
      "mcp__landing-factory__get_landing",
      "mcp__landing-factory__get_qa",
      "mcp__landing-factory__get_report",
      "mcp__landing-factory__brief_init",
      "mcp__landing-factory__brief_validate",
      "mcp__landing-factory__brief_missing",
      "mcp__landing-factory__brief_summary",
      "mcp__landing-factory__brief_update",
      "mcp__landing-factory__choose_direction",
      "mcp__landing-factory__get_job",
      "mcp__landing-factory__list_jobs",
      "mcp__landing-factory__tail_job_log"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/setup-agent.sh\" --verify",
            "timeout": 15,
            "statusMessage": "Verifying agent tooling"
          }
        ]
      }
    ]
  }
}
