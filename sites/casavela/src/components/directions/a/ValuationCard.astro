---
// Framed product-style card that previews the free valuation (built in HTML, not an image).
import { site } from '../../../content/site';
import { card } from './copy';
---

<div class="bg-surface border-line rounded-lg border p-3 sm:p-4">
  <article class="bg-paper border-line rounded-lg border shadow-sm">
    <div class="border-line flex items-start justify-between gap-4 border-b p-5 sm:p-6">
      <div>
        <p class="text-ink-soft text-xs">{card.label}</p>
        <h2 class="font-display mt-1 text-lg leading-snug font-medium">
          {card.title}
        </h2>
      </div>
      <p class="bg-primary/10 text-primary rounded-pill shrink-0 px-3 py-1 text-sm font-semibold">
        {card.price}
      </p>
    </div>
    <div class="p-5 sm:p-6">
      <h3 class="text-ink-soft text-xs font-medium">{card.stepsTitle}</h3>
      <ol class="mt-4 space-y-4">
        {card.steps.map((step, index) => (
          <li class="flex gap-3 text-sm leading-relaxed">
            <span
              aria-hidden="true"
              class="border-line text-primary flex size-6 shrink-0 items-center justify-center rounded-full border text-xs font-semibold tabular-nums"
            >
              {index + 1}
            </span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="border-line border-t p-5 sm:p-6">
      <h3 class="text-ink-soft text-xs font-medium">{card.areaTitle}</h3>
      <ul class="mt-3 flex flex-wrap gap-2">
        {site.serviceArea.map((place) => (
          <li class="bg-surface rounded-sm px-2.5 py-1 text-xs">{place}</li>
        ))}
      </ul>
    </div>
  </article>
</div>
