---
/** Questions: a centered heading over one centered column of native <details> (works without JavaScript). Brief facts only. */
import Container from '../ui/Container.astro';
import TwoTone from '../ui/TwoTone.astro';
import { faq } from '../../content/site';
---

<section
  id={faq.id}
  aria-labelledby={`${faq.id}-titulo`}
  class="scroll-mt-20 pt-28 md:pt-36 lg:pt-44"
>
  <Container>
    <div data-reveal>
      <TwoTone
        text={faq.heading}
        id={`${faq.id}-titulo`}
        class="mx-auto max-w-3xl text-center text-2xl leading-[1.1] font-medium tracking-[-0.015em] text-balance"
      />
    </div>
    <div
      data-reveal
      data-reveal-delay="0.08"
      class="mx-auto mt-10 max-w-3xl md:mt-14"
    >
      {faq.items.map((item) => (
        <details class="group border-line border-t last:border-b">
          <summary class="text-ink hover:text-primary flex cursor-pointer items-start justify-between gap-6 py-5 text-lg font-medium transition-colors duration-150">
            <span>{item.question}</span>
            <span
              aria-hidden="true"
              class="text-ink-muted shrink-0 text-xl leading-none transition-transform duration-150 group-open:rotate-45"
            >
              +
            </span>
          </summary>
          <p class="text-ink-soft max-w-2xl pb-6">{item.answer}</p>
        </details>
      ))}
    </div>
  </Container>
</section>
