---
/** Four facts from the brief in one hairline-divided row (2 x 2 on phones), in place of a logo strip. */
import Container from '../ui/Container.astro';
import MonoLabel from '../ui/MonoLabel.astro';
import { facts, factsLabel } from '../../content/site';
---

<section id="datos" aria-label={factsLabel} class="pt-12 md:pt-16">
  <Container>
    <dl class="border-line grid grid-cols-2 border-t border-b lg:grid-cols-4">
      {facts.map((fact, index) => (
        <div
          class:list={[
            'border-line flex flex-col gap-2 py-6 pr-4 lg:px-6 lg:py-8',
            index % 2 === 1 && 'border-l pl-4',
            index >= 2 && 'border-t lg:border-t-0',
            index === 2 && 'lg:border-l',
            index === 0 && 'lg:pl-0',
          ]}
        >
          <dt>
            <MonoLabel>{fact.label}</MonoLabel>
          </dt>
          <dd class="text-ink text-base font-medium">{fact.text}</dd>
        </div>
      ))}
    </dl>
  </Container>
</section>
