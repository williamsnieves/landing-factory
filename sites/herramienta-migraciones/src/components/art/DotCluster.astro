---
/** Comunidad: three loose groups of dots drawing together, one of them in the accent (a newcomer). */
import { clusterDots, seeded } from './dots';

interface Props {
  label: string;
}
const { label } = Astro.props;

const random = seeded(4004);
const R: [number, number] = [1.6, 3.2];
const dots = [
  ...clusterDots(random, { cx: 66, cy: 70, rx: 46, ry: 36, count: 34 }, R),
  ...clusterDots(random, { cx: 150, cy: 52, rx: 40, ry: 30, count: 26 }, R),
  ...clusterDots(random, { cx: 132, cy: 120, rx: 50, ry: 24, count: 28 }, R),
];
---

<svg
  viewBox="0 0 240 168"
  role="img"
  aria-label={label}
  class="block h-auto w-full max-w-[17.5rem]"
>
  <title>{label}</title>
  <g class="fill-dot">
    {dots.map((dot) => (
      <circle cx={dot.x} cy={dot.y} r={dot.r} />
    ))}
  </g>
  <circle cx="206" cy="92" r="4.5" class="fill-primary"></circle>
  <path
    d="M200 92H184"
    class="stroke-primary"
    stroke-width="1.25"
    stroke-dasharray="2 3"
  ></path>
</svg>
