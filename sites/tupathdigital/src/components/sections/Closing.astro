---
import {
  COUPON_END,
  PRIMARY,
  SECONDARY,
  SOCIAL,
  productCount,
} from '../../data/catalog';
---

<section class="closing section-pad" aria-labelledby="closing-title">
  <div class="wrap grid">
    <div class="main" data-reveal>
      <h2 id="closing-title">Pick a shelf. Start making.</h2>
      <p>
        {productCount} products in two stores, half price with a code until{' '}
        {COUPON_END}.
      </p>
      <div class="actions">
        <a
          class="btn btn-lg"
          href={PRIMARY.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {PRIMARY.label}
        </a>
        <a
          class="link-arrow"
          href={SECONDARY.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {SECONDARY.label}
        </a>
      </div>
    </div>
    <div class="social" data-reveal data-reveal-delay="0.12">
      <h3>Follow along</h3>
      <ul>
        {SOCIAL.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener noreferrer">
              {s.network}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* Soft brand-blue glow, faded to nothing inside the section box. */
  .closing {
    background-image: radial-gradient(
      ellipse 70% 55% at 50% 50%,
      color-mix(in oklab, var(--color-primary) 18%, transparent),
      transparent 100%
    );
  }
  .grid {
    display: grid;
    align-items: start;
    gap: 1rem;
  }
  .main,
  .social {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-tile);
    padding: clamp(1.5rem, 4vw, 3.5rem);
  }
  .main {
    background:
      radial-gradient(
        ellipse 70% 90% at 85% 110%,
        color-mix(in oklab, var(--color-primary) 38%, transparent),
        transparent 70%
      ),
      var(--color-surface);
    border-color: var(--color-primary);
  }
  h2 {
    margin: 0;
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .main p {
    margin: 1.25rem 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-lg);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: 2rem;
  }
  .social {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--color-surface);
  }
  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-ink-soft);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
  }
  li + li {
    border-top: 1px solid var(--color-line);
  }
  li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.5rem;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  li a::after {
    content: '\2197';
    color: var(--color-accent);
    transition: translate var(--duration-base) var(--ease-out);
  }
  li a:hover {
    color: var(--color-accent);
  }
  li a:hover::after {
    translate: 0.2rem -0.2rem;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 2fr 1fr;
      gap: 1.5rem;
    }
  }
</style>
