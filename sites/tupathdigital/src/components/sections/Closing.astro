---
import {
  COUPON_END,
  PRIMARY,
  SECONDARY,
  productCount,
} from '../../data/catalog';
---

<section class="closing section-pad" aria-labelledby="closing-title">
  <div class="wrap">
    <div class="box card" data-reveal>
      <p class="eyebrow">Ready when you are</p>
      <h2 id="closing-title">
        Pick a product. <em class="hl">Start</em> making.
      </h2>
      <p class="sub">
        {productCount} products in two stores, half price with a code until{' '}
        {COUPON_END}.
      </p>
      <div class="actions">
        <a
          class="btn btn-lg"
          href={PRIMARY.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {PRIMARY.label}
        </a>
        <a
          class="btn btn-lg btn-ghost"
          href={SECONDARY.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {SECONDARY.label}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .box {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(2.5rem, 7vw, 5.5rem) clamp(1.25rem, 4vw, 3rem);
    border-color: color-mix(
      in oklab,
      var(--color-primary) 55%,
      var(--color-line)
    );
    /* Soft brand-blue glow, faded to nothing inside the card. */
    background:
      radial-gradient(
        ellipse 60% 70% at 50% 110%,
        color-mix(in oklab, var(--color-primary) 45%, transparent),
        transparent 100%
      ),
      var(--color-surface);
  }
  h2 {
    margin: 1rem 0 0;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .sub {
    margin: 1.25rem 0 0;
    max-width: 30rem;
    color: var(--color-ink-soft);
    font-size: var(--text-lg);
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
