---
import { Picture } from 'astro:assets';
import { images } from '../../data/images';
import { orderHref, site } from '../../data/site';
---

<section
  id="top"
  class="bg-ink text-paper relative isolate flex min-h-svh items-end overflow-hidden"
>
  <Picture
    src={images.hero.src}
    alt={images.hero.alt}
    formats={['avif', 'webp']}
    widths={[640, 960, 1280, 1600, 2000]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
    style={`object-position: ${images.hero.position}`}
  />
  <!-- Flat neutral scrim so the statement stays legible on the photo. -->
  <div class="bg-ink/60 absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="mx-auto grid w-full max-w-[110rem] px-(--gutter) pt-32 pb-10 md:grid-cols-12 md:pb-12">
    <div class="md:col-span-8 md:col-start-5 xl:col-span-6 xl:col-start-7">
      <h1
        data-reveal
        class="font-display text-[clamp(2.5rem,4.9vw,4.75rem)] leading-[1] font-medium tracking-tight text-balance"
      >
        Dos días de masa madre en cada hogaza.
      </h1>
      <p
        data-reveal
        data-reveal-delay="0.15"
        class="mt-6 max-w-[40ch] text-lg md:text-xl"
      >
        Pan de fermentación lenta, horneado cada mañana en Gràcia.
      </p>
      <div
        data-reveal
        data-reveal-delay="0.3"
        class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4"
      >
        <a
          href={orderHref}
          class="bg-primary text-primary-contrast rounded-pill hover:bg-primary-hover inline-flex min-h-12 items-center px-7 font-semibold transition-colors duration-(--duration-fast)"
        >
          Encarga para recoger
        </a>
        <a
          href={site.mapUrl}
          class="inline-flex min-h-12 items-center font-medium underline decoration-2 underline-offset-8 hover:no-underline"
          rel="noopener"
        >
          Cómo llegar
        </a>
      </div>
      <p data-reveal data-reveal-delay="0.4" class="mt-8 text-base">
        Abierto hoy hasta las 20:00
      </p>
    </div>
  </div>
</section>
