{
  "name": "landing-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "sites/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:sites": "npm run check --workspaces --if-present",
    "lint": "npm run lint:code && npm run lint:unused && node scripts/site-layers.mjs check",
    "lint:code": "eslint src \"sites/*/src/**\"",
    "lint:unused": "knip --include files,dependencies --no-config-hints",
    "site-layers": "node scripts/site-layers.mjs",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:agent": "bash scripts/setup-agent.sh",
    "setup:verify": "bash scripts/setup-agent.sh --verify",
    "validate:patterns": "node scripts/validate-pattern.mjs",
    "validate:archetypes": "node scripts/validate-archetypes.mjs",
    "pick-archetypes": "node scripts/pick-archetypes.mjs",
    "layout-signature": "node scripts/layout-signature.mjs",
    "qa": "node scripts/qa.mjs",
    "report": "node scripts/landing-report.mjs",
    "new-site": "node scripts/new-site.mjs",
    "new-landing": "bash scripts/new-landing.sh",
    "brief": "node scripts/brief.mjs",
    "directions": "node scripts/directions.mjs",
    "mcp": "node scripts/mcp/server.mjs",
    "preflight": "node scripts/preflight.mjs",
    "find-images": "node scripts/find-images.mjs",
    "ai-images": "node scripts/ai-images.mjs",
    "deploy": "node scripts/deploy.mjs",
    "export": "node scripts/export.mjs",
    "handoff": "node scripts/handoff.mjs",
    "credits": "node scripts/credits.mjs",
    "legal": "node scripts/legal.mjs",
    "section-shots": "node scripts/section-shots.mjs",
    "check-landing": "node scripts/check-landing.mjs",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "chrome-launcher": "1.2.2",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "knip": "6.43.0",
    "lighthouse": "13.5.0",
    "playwright": "1.56.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.1",
    "wrangler": "4.151.1"
  }
}
