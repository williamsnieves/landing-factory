---
import { appointmentHref, hours, site } from '../../data/site';
---

<section
  id="pedir-cita"
  aria-labelledby="cita-title"
  class="scroll-mt-16 px-(--gutter) pb-(--section-y)"
>
  <div class="bg-surface rounded-frame mx-auto grid max-w-[90rem] gap-12 px-6 py-14 sm:px-12 md:py-20 lg:grid-cols-12 lg:gap-16 lg:px-20">
    <div class="lg:col-span-7">
      <h2
        id="cita-title"
        data-reveal
        class="font-display text-3xl font-medium text-balance"
      >
        Pide cita cuando te venga bien.
      </h2>
      <p data-reveal data-reveal-delay="0.1" class="mt-5 max-w-[48ch] text-lg">
        Llámanos o escríbenos. Si quieres, cuéntanos qué te preocupa o qué te
        gustaría consultar, y te respondemos para buscar un hueco.
      </p>
      <div
        data-reveal
        data-reveal-delay="0.2"
        class="mt-10 flex flex-col items-start gap-4"
      >
        <a
          href={site.phoneHref}
          class="bg-primary text-primary-contrast rounded-pill hover:bg-primary-hover font-display inline-flex min-h-16 items-center px-8 text-xl font-semibold transition-colors duration-(--duration-fast) md:min-h-20 md:px-12"
        >
          Llamar: {site.phone}
        </a>
        <a
          href={appointmentHref}
          class="text-primary decoration-primary inline-flex min-h-12 items-center text-lg font-medium underline underline-offset-4 hover:no-underline"
        >
          O escríbenos a {site.email}
        </a>
        <p class="text-ink-soft text-xs">
          Teléfono y correo de ejemplo: no son reales.
        </p>
      </div>
    </div>

    <div data-reveal data-reveal-delay="0.15" class="lg:col-span-5">
      <h3 class="font-display text-xl font-semibold">Dónde estamos</h3>
      <p class="mt-3 text-lg">
        {site.street}
        <br />
        {site.area}
      </p>
      <a
        href={site.mapUrl}
        rel="noopener"
        class="text-primary decoration-primary mt-2 inline-flex min-h-11 items-center font-medium underline underline-offset-4 hover:no-underline"
      >
        Cómo llegar
      </a>

      <h3 class="font-display mt-8 text-xl font-semibold">Horario</h3>
      <table
        class="mt-3 w-full border-collapse text-left"
        aria-label="Horario de ejemplo"
      >
        <tbody>
          {hours.map((h) => (
            <tr class="border-line border-b">
              <th scope="row" class="py-3 pr-4 align-top font-medium">
                {h.day}
              </th>
              <td class="py-3 text-right">{h.time}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="text-ink-soft mt-3 text-xs">
        Horario y dirección de ejemplo, para sustituir antes de publicar.
      </p>
    </div>
  </div>
</section>
