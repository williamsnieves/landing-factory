---
// Primary action as a hard rectangle (inverts on hover) and the secondary as an underlined text link with an arrow.
import { site } from '../../../content/site';
---

<div class="flex flex-wrap items-center gap-x-8 gap-y-4">
  <a
    href={site.primary.href}
    class="bg-primary text-primary-contrast border-ink hover:bg-ink hover:text-paper inline-flex items-center gap-3 rounded-sm border-2 px-5 py-4 text-base font-semibold"
  >
    {site.primary.label}
    <span aria-hidden="true" class="font-mono whitespace-nowrap">
      -&gt;
    </span>
  </a>
  <a
    href={site.secondary.href}
    class="decoration-primary inline-flex items-center gap-2 text-base font-semibold underline decoration-2 underline-offset-4 hover:no-underline"
  >
    {site.secondary.label}
    <span class="font-mono text-sm">{site.contact.phone}</span>
  </a>
</div>
