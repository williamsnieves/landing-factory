---
import { orderHref, site } from '../../data/site';
---

<section
  id="encargar"
  aria-labelledby="encargar-title"
  class="bg-paper scroll-mt-16 py-(--section-y)"
>
  <div class="mx-auto grid max-w-[110rem] items-end gap-10 px-(--gutter) md:grid-cols-12">
    <div class="md:col-span-5">
      <h2
        id="encargar-title"
        data-reveal
        class="font-display text-3xl leading-[1.05] font-medium tracking-tight text-balance"
      >
        Encarga hoy, recoge mañana.
      </h2>
      <p data-reveal data-reveal-delay="0.1" class="mt-6 max-w-[46ch] text-lg">
        Para tener tu hogaza esperándote, encárgala el día antes. Escríbenos con
        qué quieres y a qué hora pasarás, y te confirmamos por correo.
      </p>
    </div>
    <div
      data-reveal
      data-reveal-delay="0.2"
      class="flex flex-col items-start gap-5 md:col-span-7 md:items-end lg:col-span-5 lg:col-start-8"
    >
      <a
        href={orderHref}
        class="bg-primary text-primary-contrast rounded-pill hover:bg-primary-hover font-display inline-flex min-h-16 w-full items-center justify-center px-8 text-xl font-semibold whitespace-nowrap transition-colors duration-(--duration-fast) sm:w-auto md:min-h-24 md:w-auto md:px-12 lg:text-2xl"
      >
        Encarga para recoger
      </a>
      <p class="text-ink-soft">
        ¿Prefieres llamar?{' '}
        <a
          href={site.phoneHref}
          class="text-primary decoration-primary font-medium underline underline-offset-4 hover:no-underline"
        >
          {site.phone}
        </a>
      </p>
    </div>
  </div>
</section>
