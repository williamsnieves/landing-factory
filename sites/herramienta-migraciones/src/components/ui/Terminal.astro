---
/**
 * The signature moment: a near-black terminal with a first session as real, selectable text. Lines reveal one after
 * another when the block enters the viewport; the cursor blinks at the end (still under reduced motion). The body
 * scrolls sideways inside the block on narrow screens, so it is focusable and labelled.
 */
import type { TerminalLine } from '../../content/site';

interface Props {
  title: string;
  caption: string;
  label: string;
  lines: TerminalLine[];
}
const { title, caption, label, lines } = Astro.props;

interface Segment {
  text: string;
  class: string;
}
const segmentsOf = (line: TerminalLine): Segment[] => {
  switch (line.tone) {
    case 'command':
      return [
        { text: '$ ', class: 'text-terminal-muted select-none' },
        { text: line.text, class: 'text-terminal-text' },
      ];
    case 'applied':
      return [
        { text: '  ✓ ', class: 'text-terminal-accent' },
        { text: line.text, class: 'text-terminal-text' },
        { text: `   ${line.status ?? ''}`, class: 'text-terminal-accent' },
        ...(line.meta
          ? [{ text: `   ${line.meta}`, class: 'text-terminal-muted' }]
          : []),
      ];
    case 'muted':
      return [{ text: line.text, class: 'text-terminal-muted' }];
    default:
      return [{ text: line.text, class: 'text-terminal-text' }];
  }
};
const rows = lines.map((line, index) => ({
  segments: segmentsOf(line),
  delay: (0.12 + index * 0.07).toFixed(2),
  gap: line.tone === 'command' && index > 0,
}));
const lastDelay = (0.12 + lines.length * 0.07).toFixed(2);
---

<figure class="bg-terminal text-terminal-text">
  <div class="border-terminal-muted/30 flex items-center justify-between gap-4 border-b px-5 py-3 sm:px-8">
    <span class="font-mono text-terminal-muted text-xs">{title}</span>
    <span class="font-mono text-terminal-muted text-2xs uppercase tracking-[0.06em]">
      zsh
    </span>
  </div>
  {/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- the session scrolls sideways on narrow screens and holds no focusable child, so the labelled region takes focus itself to be scrollable with the keyboard (WCAG 2.1.1) */}
  <div
    class="terminal-body font-mono overflow-x-auto px-5 py-6 text-sm leading-relaxed sm:px-8 sm:py-8"
    tabindex="0"
    role="region"
    aria-label={label}
  >
    <code class="block min-w-max">
      {rows.map((row) => (
        <span
          class:list={['block whitespace-nowrap', row.gap && 'mt-3']}
          data-reveal
          data-reveal-y="6"
          data-reveal-delay={row.delay}
        >
          {row.segments.map((segment) => (
            <span class:list={['whitespace-pre', segment.class]}>
              {segment.text}
            </span>
          ))}
        </span>
      ))}
      <span
        class="mt-3 block whitespace-nowrap"
        data-reveal
        data-reveal-y="6"
        data-reveal-delay={lastDelay}
      >
        <span class="text-terminal-muted select-none whitespace-pre">$ </span>
        <span
          class="terminal-cursor bg-terminal-accent"
          aria-hidden="true"
        ></span>
      </span>
    </code>
  </div>
  {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
  <figcaption class="border-terminal-muted/30 text-terminal-muted border-t px-5 py-3 text-xs sm:px-8">
    {caption}
  </figcaption>
</figure>

<style>
  .terminal-body {
    font-variant-ligatures: none;
  }
  .terminal-cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    vertical-align: text-bottom;
    animation: blink 1.1s steps(1, end) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .terminal-cursor {
      animation: none;
    }
  }
</style>
