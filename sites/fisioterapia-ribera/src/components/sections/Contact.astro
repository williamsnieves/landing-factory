---
/**
 * Horario y contacto (PAS: Solution). The lent `hours-card`: the week's hours set large on the tint, on five columns,
 * beside the address, phone and email on seven with the primary action. "Cómo llegar" is a plain OpenStreetMap link:
 * no embedded map (it would set third-party cookies). The card has no "today" marker: that would need JavaScript.
 */
import ActionLink from '../ui/ActionLink.astro';
import ExampleNote from '../ui/ExampleNote.astro';
import {
  contact,
  contactSection,
  exampleNotes,
  hoursCard,
  primaryAction,
} from '../../data/site';
---

<section
  id="contacto"
  aria-labelledby="contacto-titulo"
  class="border-line border-t py-16 md:py-24"
>
  <div class="wrap">
    <div class="grid-12 gap-y-3" data-reveal>
      <h2
        id="contacto-titulo"
        class="col-span-12 text-xl leading-tight font-semibold md:col-span-5"
      >
        {contactSection.heading}
      </h2>
      <p class="col-span-12 max-w-[56ch] text-lg md:col-span-7">
        {contactSection.intro}
      </p>
    </div>
    <div class="grid-12 mt-12 gap-y-12 md:mt-16">
      <div
        class="bg-tint col-span-12 p-4 sm:p-6 lg:col-span-5 xl:p-8"
        data-reveal
      >
        <h3 class="text-lg font-semibold">{hoursCard.heading}</h3>
        <table
          class="mt-6 w-full text-left tabular-nums"
          aria-label={contact.hours}
        >
          <thead>
            <tr class="text-ink-soft text-sm">
              <td class="pb-2"></td>
              <th scope="col" class="pb-2 font-normal">
                {hoursCard.morningLabel}
              </th>
              <th scope="col" class="pb-2 font-normal">
                {hoursCard.afternoonLabel}
              </th>
            </tr>
          </thead>
          <tbody>
            {hoursCard.days.map((day) => (
              <tr class="border-ink-soft/30 border-t">
                <th
                  scope="row"
                  class="py-3 pr-2 text-base font-semibold sm:pr-3"
                >
                  {day.day}
                </th>
                <td class="py-3 pr-2 text-base whitespace-nowrap sm:pr-3 sm:text-lg xl:text-xl">
                  {day.morning}
                </td>
                <td class="py-3 text-base whitespace-nowrap sm:text-lg xl:text-xl">
                  {day.afternoon}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="col-span-12 lg:col-span-7 lg:pl-12">
        <dl class="space-y-6">
          {contactSection.facts.map((fact, index) => (
            <div
              data-reveal
              data-reveal-y="16"
              data-reveal-delay={String(index * 0.08)}
            >
              <dt class="text-ink-soft text-sm">{fact.label}</dt>
              <dd class="mt-1 text-xl leading-snug break-words tabular-nums">
                {fact.href ? (
                  <a
                    href={fact.href}
                    class="decoration-ink-soft hover:text-primary hover:decoration-primary underline decoration-1 underline-offset-4 transition-colors duration-(--duration-fast)"
                  >
                    {fact.value}
                  </a>
                ) : (
                  fact.value
                )}
              </dd>
            </div>
          ))}
        </dl>
        <p class="mt-4" data-reveal>
          <a
            href={contact.mapHref}
            target="_blank"
            rel="noopener"
            class="text-primary hover:text-primary-hover inline-flex min-h-11 items-center text-base font-semibold underline underline-offset-4"
          >
            {contact.mapLabel}
          </a>
        </p>
        <div class="mt-8" data-reveal>
          <ActionLink href={primaryAction.href} label={primaryAction.label} />
        </div>
        <ExampleNote text={exampleNotes.facts} class="mt-8" />
      </div>
    </div>
  </div>
</section>
