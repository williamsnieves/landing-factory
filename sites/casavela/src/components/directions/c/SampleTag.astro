---
// Small label that marks a value as sample data ("Dato de ejemplo"), so an assumed brief value is never read as
// a confirmed fact. Ink on surface (or on paper inside surface cards) keeps well above 4.5:1.
import { sampleTag } from './copy';

interface Props {
  /** True when the tag sits on a surface-colored card: it then takes the paper background to stand out. */
  onSurface?: boolean;
}

const { onSurface = false } = Astro.props;
---

<span
  class:list={[
    'text-ink border-line inline-block rounded-sm border px-2 py-0.5 text-xs font-semibold whitespace-nowrap',
    onSurface ? 'bg-paper' : 'bg-surface',
  ]}
>
  {sampleTag}
</span>
