---
// The page's button pair: filled primary (WhatsApp valuation) and outlined secondary (phone), from the brief.
// Pills (radius-pill), the page's one button shape (see RUN.md Design decisions).
import { site } from '../../content/site';
---

<div class="flex flex-wrap items-center gap-3">
  <a
    href={site.primary.href}
    class="bg-primary text-primary-contrast hover:bg-primary-hover inline-flex min-h-12 items-center gap-2 rounded-pill px-6 py-3 text-base font-medium transition-colors"
  >
    {site.primary.label}
    <span aria-hidden="true">→</span>
  </a>
  <a
    href={site.secondary.href}
    class="border-ink text-ink hover:border-primary hover:text-primary inline-flex min-h-12 items-center rounded-pill border px-6 py-3 text-base font-medium transition-colors"
  >
    {site.secondary.label}
  </a>
</div>
