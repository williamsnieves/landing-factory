---
/** Estrato's mark: three strata stepping down, each wider than the one above (also public/favicon.svg). */
interface Props {
  class?: string;
}
const { class: className = 'size-6' } = Astro.props;
---

<svg
  class:list={['text-primary shrink-0', className]}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <rect x="4" y="6" width="14" height="5" fill="currentColor"></rect>
  <rect x="4" y="13.5" width="19" height="5" fill="currentColor"></rect>
  <rect x="4" y="21" width="24" height="5" class="fill-ink"></rect>
</svg>
