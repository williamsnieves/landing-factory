---
import { COUPON_END, productCount, shelves } from '../../data/catalog';

const figures = [
  {
    value: String(productCount),
    label: 'Products',
    note: 'Guides, packs and bundles',
  },
  { value: '2', label: 'Stores', note: 'Etsy and Gumroad' },
  { value: '50%', label: 'Off with a code', note: `Until ${COUPON_END}` },
  {
    value: String(shelves.length),
    label: 'Shelves',
    note: 'AI, 3D, wallpapers, guides',
  },
];
---

<section class="figures" aria-label="The catalog in numbers">
  <div class="wrap">
    <dl class="row">
      {figures.map((f, i) => (
        <div class="fig" data-reveal data-reveal-delay={i * 0.08}>
          <dt class="label">{f.label}</dt>
          <dd class="value">{f.value}</dd>
          <dd class="note">{f.note}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .figures {
    padding-block: 0 clamp(3rem, 6vw, 5rem);
  }
  .row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin: 0;
  }
  .fig {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-tile);
  }
  .value {
    order: 1;
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-3xl);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .label {
    order: 2;
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .note {
    order: 3;
    margin: 0.25rem 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }
  @media (min-width: 900px) {
    .row {
      grid-template-columns: 1.3fr 0.8fr 1.1fr 1fr;
      gap: 1rem;
    }
    .fig {
      padding: 1.75rem;
    }
  }
</style>
