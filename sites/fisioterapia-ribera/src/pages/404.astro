---
// Not-found page: the build emits dist/404.html, which static hosts serve with status 404.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import NotFound from '../components/sections/NotFound.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import { meta, notFound } from '../data/site';
---

<BaseLayout
  title={notFound.title}
  description={notFound.description}
  lang="es"
  skipLabel={meta.skipLabel}
  noindex
>
  <SiteHeader slot="header" base="/" />
  <NotFound />
  <SiteFooter slot="footer" />
</BaseLayout>
