---
import Chapter from '../Chapter.astro';

const stages = [
  {
    title: 'Primera conversación',
    text: 'Nos cuenta qué inmueble tiene y qué querría cambiar. Hablamos por teléfono o en el estudio.',
  },
  {
    title: 'Visita al inmueble',
    text: 'Vamos a verlo, hacemos fotografías y tomamos medidas generales para saber si el encargo es viable.',
  },
  {
    title: 'Propuesta de encargo',
    text: 'Le enviamos por escrito el alcance, los plazos y los honorarios. Los honorarios se acuerdan después de la visita, nunca antes.',
  },
  {
    title: 'Firma e inicio',
    text: 'Con el encargo firmado empieza el levantamiento y el primer paso del método.',
  },
];

const bring = [
  'Planos, escrituras o la nota simple, si los tiene.',
  'Fotografías del inmueble tal como está.',
  'Una lista de lo que necesita, en orden de importancia.',
  'El presupuesto aproximado y la fecha en la que querría empezar.',
];
---

<section
  id="encargo"
  class="border-line scroll-mt-4 border-t"
  aria-labelledby="encargo-title"
>
  <div class="wrap grid grid-cols-12 gap-x-4 gap-y-8 py-24 md:gap-x-6 md:py-40">
    <div class="col-span-12 md:col-span-3">
      <Chapter n="V" label="Encargo" />
    </div>
    <div class="col-span-12 md:col-span-9">
      <h2
        id="encargo-title"
        class="font-display max-w-[24ch] text-3xl leading-[1.15] font-medium tracking-tight text-balance"
        data-reveal
      >
        Cómo una consulta se convierte en un encargo.
      </h2>

      <ol class="mt-12 grid gap-x-6 sm:grid-cols-2 xl:grid-cols-4">
        {stages.map((s, i) => (
          <li class="border-line border-t py-6" data-reveal>
            <span class="font-display text-primary tabular-nums">{i + 1}</span>
            <h3 class="font-display mt-4 text-lg font-medium">{s.title}</h3>
            <p class="text-ink-soft mt-2 max-w-[44ch]">{s.text}</p>
          </li>
        ))}
      </ol>

      <div class="mt-12 max-w-[60ch]" data-reveal>
        <h3 class="font-display text-lg font-medium">Qué conviene traer</h3>
        <ul class="border-line mt-4 border-t">
          {bring.map((b) => (
            <li class="border-line border-b py-3 text-sm">{b}</li>
          ))}
        </ul>
        <p class="text-ink-soft mt-6 text-sm">
          Si no tiene nada de esto, no importa: con una dirección y una idea es
          suficiente para empezar a hablar.
        </p>
      </div>
    </div>
  </div>
</section>
