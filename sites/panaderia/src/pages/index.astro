---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Horno Lento — Panadería de masa madre en Barcelona';
const description =
  'Horno Lento, panadería de masa madre en Barcelona. Nuestra web está en construcción.';
const lang = 'es';
const message = 'Estamos preparando la web de Horno Lento. Vuelve pronto.';
---

<BaseLayout title={title} description={description} lang={lang} noindex>
  <section class="mx-auto max-w-5xl px-6 py-32 md:py-48">
    <h1 class="font-display text-4xl leading-none font-medium tracking-tight text-balance">
      {title}
    </h1>
    <p class="text-ink-soft mt-6 text-lg">{message}</p>
  </section>
</BaseLayout>
