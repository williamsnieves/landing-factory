---
import credits from '../../data/credits.json';

const cols = [
  {
    title: 'Producto',
    items: [
      { label: 'Cómo funciona', href: '#como-funciona' },
      { label: 'Planes', href: '#planes' },
      { label: 'Preguntas frecuentes', href: '#faq' },
    ],
  },
  {
    title: 'Seguridad',
    items: [{ label: 'Privacidad y seguridad', href: '#seguridad' }],
  },
  {
    title: 'Empresa y legal',
    items: [
      { label: 'Contacto: hola@trazo.example (ejemplo)' },
      { label: 'Aviso legal (pendiente)' },
      { label: 'Política de privacidad (pendiente)' },
    ],
  },
];
const photos = Array.isArray(credits) ? credits : [];
---

<footer>
  <div class="mx-auto w-full max-w-6xl px-4 py-12 md:px-8">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <p class="font-display text-xl font-extrabold tracking-tight">Trazo</p>
        <p class="text-ink-soft mt-2 max-w-xs text-sm">
          App de finanzas personales. Marca, cifras, precios y enlaces de esta
          página son de ejemplo.
        </p>
      </div>
      {cols.map((c) => (
        <nav aria-label={c.title} class="md:col-span-2">
          <p class="font-display font-semibold">{c.title}</p>
          <ul class="mt-3 flex flex-col gap-2 text-sm">
            {c.items.map((i) => (
              <li>
                {'href' in i ? (
                  <a
                    href={i.href}
                    class="hover:text-primary underline-offset-4 hover:underline"
                  >
                    {i.label}
                  </a>
                ) : (
                  <span class="text-ink-soft">{i.label}</span>
                )}
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="border-line text-ink-soft mt-10 border-t pt-6 text-sm">
      <p>
        Tipografías Manrope y Onest, licencia SIL OFL 1.1. Las pantallas de la
        app están dibujadas en código con datos de ejemplo.
      </p>
      {photos.length > 0 && (
        <ul class="mt-2">
          {photos.map(
            (p: { author?: string; license?: string; title?: string }) => (
              <li>
                {p.title} · {p.author} · {p.license}
              </li>
            ),
          )}
        </ul>
      )}
    </div>
  </div>
</footer>
