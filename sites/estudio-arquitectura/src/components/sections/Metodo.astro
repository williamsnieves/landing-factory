---
import Chapter from '../Chapter.astro';

const steps = [
  {
    title: 'Levantamiento',
    text: 'Medimos el inmueble entero, abrimos catas donde hace falta y dibujamos el estado real: muros, forjados, instalaciones y patologías.',
    output: 'Planos del estado actual y una nota con lo encontrado.',
  },
  {
    title: 'Diagnóstico',
    text: 'Decidimos con usted qué se conserva, qué se repara y qué se sustituye, y qué cabe en el plazo y en el presupuesto que tiene en mente.',
    output: 'Un documento breve con las opciones y su razonamiento.',
  },
  {
    title: 'Proyecto',
    text: 'Dibujamos la distribución, los detalles constructivos y la carpintería. Elegimos materiales y los medimos partida por partida.',
    output: 'Planos, memoria, mediciones y presupuesto desglosado.',
  },
  {
    title: 'Licencia y contratación',
    text: 'Tramitamos la licencia municipal y la comunicación a la comunidad de propietarios. Pedimos ofertas comparables a varios constructores.',
    output: 'Licencia, cuadro comparativo de ofertas y contrato de obra.',
  },
  {
    title: 'Obra',
    text: 'Visitamos la obra cada semana, resolvemos los imprevistos en el momento y dejamos cada cambio por escrito antes de ejecutarlo.',
    output: 'Actas de visita, planos finales y manual de uso del inmueble.',
  },
];
---

<section
  id="metodo"
  class="bg-primary text-primary-contrast scroll-mt-4"
  aria-labelledby="metodo-title"
>
  <div class="wrap py-24 md:py-40">
    <Chapter n="III" label="Método" tone="light" />
    <div class="mt-10 grid grid-cols-12 gap-x-4 gap-y-6 md:gap-x-6">
      <h2
        id="metodo-title"
        class="font-display col-span-12 max-w-[20ch] text-4xl leading-[1.1] font-medium tracking-tight text-balance md:col-span-8"
        data-reveal
      >
        Cinco pasos, de la medición a la obra.
      </h2>
      <p class="col-span-12 max-w-[40ch] self-end md:col-span-4" data-reveal>
        El orden importa: casi todos los problemas de una obra se evitan en los
        dos primeros pasos.
      </p>
    </div>

    <ol class="mt-16 grid gap-x-6 gap-y-0 md:grid-cols-2 lg:grid-cols-5 lg:gap-y-12">
      {steps.map((s, i) => (
        <li class="metodo-step border-t py-6" data-reveal>
          <span class="font-display text-xl tabular-nums">{i + 1}</span>
          <h3 class="font-display mt-6 text-xl font-medium tracking-tight">
            {s.title}
          </h3>
          <p class="mt-3">{s.text}</p>
          <p class="mt-4 text-sm">
            <span class="font-medium">Entrega: </span>
            {s.output}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .metodo-step {
    border-color: color-mix(
      in srgb,
      var(--color-primary-contrast) 45%,
      transparent
    );
  }
</style>
