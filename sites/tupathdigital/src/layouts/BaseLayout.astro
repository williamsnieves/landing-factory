---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
  /** Absolute or root-relative URL of the Open Graph image. */
  ogImage?: string;
  /** Open Graph type of the page (`website` by default). */
  ogType?: string;
  /**
   * Structured data (schema.org) written as `<script type="application/ld+json">`. Brief facts only; no review
   * or rating markup without real reviews. `<` is escaped so a value can never close the script element.
   */
  jsonLd?: object | object[];
  /** Set to true on pages that should not be indexed (labs, tests). */
  noindex?: boolean;
}

const {
  title,
  description,
  lang = 'en',
  ogImage,
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
// JSON.stringify never emits a raw `<`, so `</script>` inside a value cannot end the block.
// The type is a variable so Prettier does not parse the block's text as JSON.
const jsonLdType = 'application/ld+json';
const jsonLdText = jsonLd
  ? JSON.stringify(jsonLd).replace(/</g, '\\u003c')
  : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={lang} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta
      name="twitter:card"
      content={ogImage ? 'summary_large_image' : 'summary'}
    />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {jsonLdText && <script type={jsonLdType} set:html={jsonLdText} />}
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="bg-ink text-paper rounded-pill fixed top-3 left-3 z-50 -translate-y-20 px-5 py-3 text-sm font-medium focus:translate-y-0"
    >
      Skip to content
    </a>
    <slot name="header" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
