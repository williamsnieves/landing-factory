---
// The button pair of direction "a": filled primary (WhatsApp) and outlined secondary (phone), from the brief.
import { site } from '../../../content/site';
---

<div class="flex flex-wrap items-center gap-3">
  <a
    href={site.primary.href}
    class="bg-primary text-primary-contrast rounded-pill inline-flex min-h-12 items-center gap-2 px-6 py-3 text-base font-medium transition-opacity hover:opacity-90"
  >
    {site.primary.label}
    <span aria-hidden="true">→</span>
  </a>
  <a
    href={site.secondary.href}
    class="border-ink-soft/40 text-ink hover:border-primary hover:text-primary rounded-pill inline-flex min-h-12 items-center border px-6 py-3 text-base font-medium transition-colors"
  >
    {site.secondary.label}
  </a>
</div>
