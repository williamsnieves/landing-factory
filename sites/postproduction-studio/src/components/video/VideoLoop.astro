---
/**
 * A poster-first looping clip (docs/video.md). The poster is real HTML (a <picture>: the LCP candidate, what
 * no-JavaScript and reduced-motion visitors see) and the <video> sits over it, muted, looping, inline, with
 * `preload="none"` and no `autoplay` attribute, so nothing is downloaded or played until client.ts decides:
 * it plays the clip while at least a quarter of it is in view, pauses it off-screen and in hidden tabs, never
 * plays under `prefers-reduced-motion`, and shows a pause button (a clip that moves for more than 5 seconds
 * needs one, WCAG 2.2.2). The clip is a file encoded by scripts/video.mjs or find-images.mjs (H.264 MP4, no
 * audio), imported through Vite so it is fingerprinted; it is served from the site, so the page adds no origin.
 * Children are drawn over the clip (put a scrim and the statement there).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { videoTexts } from './texts';

interface Props {
  /** The imported MP4 (`import clip from '../assets/video/name.mp4'`): a URL string. */
  video: string;
  /** The imported poster (`import poster from '../assets/video/name.poster.webp'`). */
  poster: ImageMetadata;
  /** What the clip shows, for a clip that carries meaning. Without it the clip is decorative (`aria-hidden`). */
  label?: string;
  /** Load the poster eagerly with high priority: use for the clip of the first screen. */
  priority?: boolean;
  /** Fill the parent (`h-full w-full`) instead of taking the poster's aspect ratio. */
  fill?: boolean;
  /** CSS aspect ratio, e.g. "16/9" (default: the poster's own ratio). Ignored with `fill`. */
  aspect?: string;
  /** Poster `sizes` attribute. */
  sizes?: string;
  /** Multi-locale sites: the locale of the page (default: Astro.currentLocale, else English). */
  locale?: string;
  class?: string;
}

const {
  video,
  poster,
  label,
  priority = false,
  fill = false,
  aspect,
  sizes = '100vw',
  locale = Astro.currentLocale ?? 'en',
  class: className,
} = Astro.props;

const t = videoTexts(locale);
const ratio = aspect ?? `${poster.width}/${poster.height}`;
---

<figure
  data-video
  data-video-state="idle"
  class:list={[
    'video-loop relative m-0 overflow-hidden',
    fill && 'h-full w-full',
    className,
  ]}
  style={fill ? undefined : `aspect-ratio:${ratio}`}
>
  <Picture
    src={poster}
    alt=""
    formats={['avif', 'webp']}
    widths={[640, 960, 1440, 1920]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
    class="absolute inset-0 block h-full w-full object-cover"
  />
  <video
    muted
    loop
    playsinline
    preload="none"
    aria-hidden={label ? undefined : 'true'}
    aria-label={label}
    tabindex="-1"
    class="absolute inset-0 block h-full w-full object-cover"
  >
    <source src={video} type="video/mp4" />
  </video>
  <slot />
  <button
    type="button"
    data-video-toggle
    data-label-pause={t.pause}
    data-label-play={t.play}
    aria-label={t.pause}
    hidden
    class="video-toggle border-line bg-paper text-ink absolute right-3 bottom-3 z-20 inline-flex size-11 items-center justify-center rounded-full border"
  >
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="currentColor"
      aria-hidden="true"
    >
      <path data-video-icon-pause d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"></path>
      <path data-video-icon-play class="hidden" d="M8 5v14l11-7z"></path>
    </svg>
  </button>
</figure>

<script>
  import './client.ts';
</script>

<style is:global>
  /* The video is invisible until it has actually played, so the poster below stays the picture of the clip. */
  .video-loop > video {
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .video-loop[data-video-started] > video {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .video-loop > video {
      transition: none;
    }
  }
</style>
