---
import BaseLayout from '../layouts/BaseLayout.astro';
import Motion from '../components/motion/Motion.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import StoreStrip from '../components/sections/StoreStrip.astro';
import Figures from '../components/sections/Figures.astro';
import Catalog from '../components/sections/Catalog.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Faq from '../components/sections/Faq.astro';
import Closing from '../components/sections/Closing.astro';
import Footer from '../components/sections/Footer.astro';
import {
  homeDescription,
  homeJsonLd,
  homeTitle,
  shareImageUrl,
} from '../data/seo';

const og = await shareImageUrl(Astro.site!);
const jsonLd = await homeJsonLd(Astro.site!);
---

<BaseLayout
  title={homeTitle}
  description={homeDescription}
  lang="en"
  ogImage={og}
  jsonLd={jsonLd}
>
  <Motion slot="head" />
  <Header slot="header" />
  <Hero />
  <StoreStrip />
  <Figures />
  <Catalog />
  <HowItWorks />
  <Faq />
  <Closing />
  <Footer slot="footer" />
</BaseLayout>
