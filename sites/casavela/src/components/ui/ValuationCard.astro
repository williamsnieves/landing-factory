---
// Framed product-style card that previews the free valuation (built in HTML, not an image): the offer and its
// price, the three steps of the visit and the service-area chips.
import { valuationCard as card } from '../../content/page';
import { site } from '../../content/site';
---

<div class="bg-surface border-line rounded-lg border p-2 sm:p-3">
  <article
    class="bg-paper border-line rounded-md border"
    aria-labelledby="valoracion-titulo"
  >
    <div class="border-line flex items-start justify-between gap-4 border-b p-5 sm:p-6">
      <div>
        <p class="text-ink-soft text-sm">{card.label}</p>
        <h2
          id="valoracion-titulo"
          class="font-display mt-1 text-lg leading-snug font-semibold"
        >
          {card.title}
        </h2>
      </div>
      <p class="bg-primary text-primary-contrast rounded-pill shrink-0 px-3 py-1 text-sm font-semibold">
        {card.price}
      </p>
    </div>
    <div class="p-5 sm:p-6">
      <h3 class="text-ink-soft text-sm font-medium">{card.stepsTitle}</h3>
      <ol class="mt-4 space-y-4">
        {card.steps.map((step, index) => (
          <li class="flex gap-3 text-base leading-snug">
            <span
              aria-hidden="true"
              class="bg-surface text-terracotta flex size-7 shrink-0 items-center justify-center rounded-sm text-sm font-semibold tabular-nums"
            >
              {index + 1}
            </span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="border-line border-t p-5 sm:p-6">
      <h3 class="text-ink-soft text-sm font-medium">{card.areaTitle}</h3>
      <ul class="mt-3 flex flex-wrap gap-2">
        {site.serviceArea.map((place) => (
          <li class="bg-surface rounded-pill px-3 py-1 text-sm">{place}</li>
        ))}
      </ul>
    </div>
  </article>
</div>
