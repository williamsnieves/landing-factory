---
// Practical strip of direction "c" (warm-local-service's own `practical-strip`): where, when and how to reach the
// agency right under the hero, each value marked as sample data, followed by the stat strip.
import SampleTag from './SampleTag.astro';
import StatStrip from './StatStrip.astro';
import { practical } from './copy';
---

<section id="c-practico" class="px-4 py-14 sm:px-6 md:py-20">
  <div class="mx-auto max-w-6xl">
    <h2 class="font-display text-2xl leading-tight">{practical.title}</h2>
    <ul class="mt-8 grid gap-4 md:grid-cols-3">
      {practical.items.map((item) => (
        <li class="bg-surface rounded-md p-5">
          <p class="flex flex-wrap items-center justify-between gap-2">
            <span class="text-ink-soft text-sm font-bold">{item.label}</span>
            <SampleTag onSurface />
          </p>
          <p class="mt-2 text-lg leading-snug font-semibold">{item.value}</p>
          {item.links && (
            <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm font-bold">
              {item.links.map((link) => (
                <a
                  href={link.href}
                  class="text-primary underline underline-offset-4 hover:no-underline"
                >
                  {link.label}
                </a>
              ))}
            </p>
          )}
        </li>
      ))}
    </ul>
    <div class="mt-6">
      <StatStrip />
    </div>
  </div>
</section>
