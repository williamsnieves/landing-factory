---
/**
 * The 50-minute ruler: a primary baseline with a tick per minute (taller every 5 and every 10 minutes), drawn in
 * equal segments of 10 minutes that reveal left to right, and the minute labels under it in tabular figures.
 * One accessible name for the whole drawing; the segments and ticks are decorative.
 */
interface Props {
  /** Accessible name of the ruler. */
  label: string;
  /** Labels at 0, 10, ... 50 minutes (segments + 1 entries). */
  minutes: readonly string[];
  /** Number of 10-minute segments. */
  segments: number;
}
const { label, minutes, segments } = Astro.props;

const tickHeight = (minute: number) =>
  minute % 10 === 0 ? 26 : minute % 5 === 0 ? 17 : 9;
const ticksFor = (segment: number) => {
  const last = segment === segments - 1;
  return Array.from({ length: last ? 11 : 10 }, (_, minute) => ({
    x: minute * 10,
    height: tickHeight(minute),
  }));
};
const labelPosition = (index: number) =>
  index === 0
    ? 'left-0'
    : index === minutes.length - 1
      ? 'right-0 text-right'
      : '-translate-x-1/2';
---

<div role="img" aria-label={label} class="text-primary">
  <div
    class="grid"
    style={`grid-template-columns: repeat(${segments}, minmax(0, 1fr));`}
  >
    {Array.from({ length: segments }, (_, segment) => (
      <div
        data-reveal
        data-reveal-y="0"
        data-reveal-delay={String(segment * 0.1)}
      >
        <svg
          viewBox="0 0 100 28"
          preserveAspectRatio="none"
          class="block h-7 w-full overflow-visible"
          aria-hidden="true"
          focusable="false"
        >
          <line
            x1="0"
            y1="1"
            x2="100"
            y2="1"
            stroke="currentColor"
            stroke-width="2"
            vector-effect="non-scaling-stroke"
          />
          {ticksFor(segment).map((tick) => (
            <line
              x1={tick.x}
              y1="1"
              x2={tick.x}
              y2={tick.height}
              stroke="currentColor"
              stroke-width={tick.height === 26 ? 2 : 1}
              vector-effect="non-scaling-stroke"
            />
          ))}
        </svg>
      </div>
    ))}
  </div>
  <div
    class="text-ink relative mt-2 h-6 text-sm tabular-nums"
    aria-hidden="true"
  >
    {minutes.map((minute, index) => (
      <span
        class:list={['absolute top-0 whitespace-nowrap', labelPosition(index)]}
        style={
          index > 0 && index < minutes.length - 1
            ? `left: ${(index / (minutes.length - 1)) * 100}%;`
            : undefined
        }
      >
        {minute}
      </span>
    ))}
  </div>
</div>
