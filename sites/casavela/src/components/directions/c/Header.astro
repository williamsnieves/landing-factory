---
// Header of direction "c": a soft notice bar (draft and sample notices), then the name in the display serif,
// three plain links, the phone number (marked as sample) and the WhatsApp action as a rounded button.
import { site } from '../../../content/site';
import { header } from './copy';
---

<div class="bg-surface text-ink px-4 sm:px-6">
  <p class="mx-auto max-w-6xl py-2 text-xs leading-snug">
    <strong class="font-bold">{site.draftNotice}</strong>{' '}
    <span>{site.sampleNotice}</span>
  </p>
</div>
<header class="border-line border-b px-4 sm:px-6">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 py-4">
    <p class="font-display text-lg leading-tight sm:text-xl">
      <span
        class="bg-accent mr-2 inline-block size-2.5 rounded-full align-middle"
        aria-hidden="true"
      ></span>
      {site.name}
    </p>
    <nav aria-label="Secciones" class="hidden lg:block">
      <ul class="flex items-center gap-6 text-sm font-semibold">
        {header.nav.map((link) => (
          <li>
            <a
              href={link.href}
              class="hover:decoration-primary underline-offset-4 hover:underline"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex shrink-0 items-center gap-4">
      <a
        href={site.contact.phoneHref}
        class="hidden text-sm font-semibold underline underline-offset-4 hover:no-underline md:inline"
      >
        {header.phoneLabel} {site.contact.phone}{' '}
        <span class="text-ink-soft font-normal">(ejemplo)</span>
      </a>
      <a
        href={site.primary.href}
        class="bg-primary text-primary-contrast hover:bg-ink rounded-md px-4 py-2.5 text-sm font-bold transition-colors"
      >
        {header.cta}
      </a>
    </div>
  </div>
</header>
