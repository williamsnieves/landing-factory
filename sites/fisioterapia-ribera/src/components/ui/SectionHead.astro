---
/**
 * Section heading block for the narrow left column: an h2 and an optional short sentence under it. Small contrast
 * between heading and text (Swiss grid); no eyebrow label.
 */
interface Props {
  id: string;
  heading: string;
  intro?: string;
}
const { id, heading, intro } = Astro.props;
---

<div data-reveal>
  <h2 id={id} class="text-xl leading-tight font-semibold">
    {heading}
  </h2>
  {intro && <p class="text-ink-soft mt-3 max-w-[32ch] text-base">{intro}</p>}
</div>
