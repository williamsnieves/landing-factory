---
/**
 * Body of the 404 page in the landing's design: flush-left heading on the grid, one sentence, a link home and the
 * primary action. No image, no motion.
 */
import ActionLink from '../ui/ActionLink.astro';
import { notFound, primaryAction } from '../../data/site';
---

<section
  id="no-encontrada"
  aria-labelledby="no-encontrada-titulo"
  class="py-20 md:py-32"
>
  <div class="wrap grid-12">
    <div class="col-span-12 md:col-span-8 lg:col-span-7">
      <h1
        id="no-encontrada-titulo"
        class="text-3xl leading-[1.15] font-semibold"
      >
        {notFound.heading}
      </h1>
      <p class="mt-6 max-w-[56ch] text-lg">{notFound.text}</p>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3">
        <ActionLink href={primaryAction.href} label={primaryAction.label} />
        <a
          href="/"
          class="hover:text-primary inline-flex min-h-12 items-center text-base font-semibold underline underline-offset-4"
        >
          {notFound.homeLabel}
        </a>
      </div>
    </div>
  </div>
</section>
