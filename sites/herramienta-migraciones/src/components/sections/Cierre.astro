---
/**
 * Cierre (`#cierre`): the next, pending migration is the visitor's. One sentence, the two actions again, then the
 * full-width generative dot field.
 */
import MigrationLabel from '../ui/MigrationLabel.astro';
import InstallButton from '../ui/InstallButton.astro';
import DemoLink from '../ui/DemoLink.astro';
import DotField from '../art/DotField.astro';
import { actions, cierre } from '../../content/site';
---

<section
  id={cierre.id}
  aria-labelledby="cierre-titulo"
  class="scroll-mt-6 pt-24 lg:pt-36"
>
  <div class="mx-auto grid max-w-[77.5rem] gap-x-12 gap-y-8 px-5 sm:px-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:px-12">
    <div data-reveal data-reveal-y="10">
      <MigrationLabel id={cierre.migration} status={cierre.status} />
    </div>
    <div class="min-w-0">
      <h2
        id="cierre-titulo"
        class="text-ink text-3xl leading-tight font-normal tracking-[-0.01em] text-balance"
        data-reveal
        data-reveal-y="10"
      >
        {cierre.title}
      </h2>
      <p
        class="text-ink-soft mt-5 max-w-[48ch] text-base"
        data-reveal
        data-reveal-y="10"
        data-reveal-delay="0.05"
      >
        {cierre.text}
      </p>
      <div
        class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3"
        data-reveal
        data-reveal-y="10"
        data-reveal-delay="0.1"
      >
        <InstallButton
          href={actions.install.href}
          label={actions.install.label}
        />
        <DemoLink label={actions.github.label} tag={actions.github.tag} />
      </div>
    </div>
  </div>
  <div class="mt-20 lg:mt-28">
    <DotField label={cierre.fieldLabel} />
  </div>
</section>
