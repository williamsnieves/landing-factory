{
  "viewports": [
    { "width": 375, "height": 812 },
    { "width": 768, "height": 1024 },
    { "width": 1440, "height": 900 }
  ],
  "pages": {
    "exclude": ["404.html"]
  },
  "reducedMotion": {
    "viewportWidth": 1440,
    "settleMs": 500
  },
  "lighthouse": {
    "thresholds": {
      "performance": 90,
      "accessibility": 90,
      "seo": 90
    },
    "reportOnly": ["best-practices"],
    "runs": 1,
    "skipCrawlableOnNoindex": true
  },
  "impeccable": {
    "version": "4.6.0",
    "target": "src",
    "severityMap": {
      "error": "major",
      "warning": "minor",
      "advisory": "info"
    },
    "failOn": ["major"]
  },
  "threeD": {
    "maxGzipKb": 200,
    "canvasTimeoutMs": 15000
  },
  "diversity": {
    "minLayoutDistance": 0.2,
    "maxHashMatch": 0.5,
    "hashHamming": 10
  },
  "brief": {
    "sampleWords": ["ejemplo", "example", "sample"]
  },
  "report": {
    "maxPageKb": 1600,
    "maxImageKb": 400,
    "legacyImageKb": 100,
    "lcpMs": 2500,
    "cls": 0.1,
    "tbtMs": 200,
    "maxFontFiles": 6,
    "maxThirdPartyOrigins": 3,
    "imageSavingsKb": 20,
    "renderBlockingMs": 500,
    "audit": { "ignore": [] },
    "externalLinks": { "max": 50, "gapMs": 250 },
    "live": { "timeoutMs": 10000 }
  },
  "legal": {
    "essentialCookies": ["__cf_bm", "cf_clearance"],
    "essentialStorageKeys": [],
    "trackers": []
  },
  "aiImages": {
    "provider": "openai",
    "model": "gpt-image-1.5",
    "size": "1536x1024",
    "quality": "high",
    "maxPerSite": 12
  }
}
