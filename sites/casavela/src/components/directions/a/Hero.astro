---
// Split hero of direction "a": two-tone headline, short line and the button pair on the left, the framed
// valuation card on the right.
import ActionPair from './ActionPair.astro';
import TwoTone from './TwoTone.astro';
import ValuationCard from './ValuationCard.astro';
import { hero } from './copy';
---

<section id="a-hero" class="px-4 sm:px-6" aria-labelledby="a-hero-title">
  <div class="border-line mx-auto grid max-w-6xl gap-12 border-x px-5 pt-14 pb-16 sm:px-8 md:pt-20 lg:grid-cols-[7fr_5fr] lg:items-center lg:gap-16 lg:px-12 lg:pt-24 lg:pb-24">
    <div>
      <p class="text-primary text-sm font-medium">{hero.eyebrow}</p>
      <h1
        id="a-hero-title"
        class="font-display mt-5 text-3xl leading-[1.08] font-light tracking-tight text-balance"
      >
        <TwoTone lead={hero.lead} rest={hero.rest} />
      </h1>
      <p class="text-ink-soft mt-6 max-w-xl text-lg leading-relaxed">
        {hero.line}
      </p>
      <div class="mt-9">
        <ActionPair />
      </div>
    </div>
    <ValuationCard />
  </div>
</section>
