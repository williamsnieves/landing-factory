# Cloudflare Pages headers (copied to dist/_headers by the build).
# Hashed build assets never change, so cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Basic hardening for every response. The script CSP (hashes of the inline scripts) is a <meta> tag per page,
# written by Astro (security.csp in astro.config.mjs); a meta tag cannot carry frame-ancestors, so it stays here.
# HSTS has no preload and no includeSubDomains, since the host may be shared with other sites.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
