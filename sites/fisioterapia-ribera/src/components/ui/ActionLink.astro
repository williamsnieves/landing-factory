---
/**
 * The primary action as the Swiss sheet's "plain text link with an arrow": semibold, a thick underline in the
 * primary colour and an arrow, no fill, no border, no radius. `primary` on the paper ground, `inverse` on the
 * primary colour field of the closing section. A real link to the booking URL; no JavaScript.
 * (Changed from a filled button in the final check: layout-diversity, see RUN.md "Design decisions".)
 */
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'inverse';
  /** `sm` for the header, `md` everywhere else. */
  size?: 'sm' | 'md';
}
const { href, label, variant = 'primary', size = 'md' } = Astro.props;
const look =
  variant === 'inverse'
    ? 'text-primary-contrast decoration-primary-contrast hover:decoration-tint'
    : 'text-primary decoration-primary hover:text-primary-hover hover:decoration-primary-hover';
const scale = size === 'sm' ? 'min-h-11 text-base' : 'min-h-12 text-lg';
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center gap-2 font-semibold underline decoration-2 underline-offset-[6px] transition-colors duration-(--duration-fast) ease-(--ease-standard)',
    look,
    scale,
  ]}
>
  <span>{label}</span>
  <span
    aria-hidden="true"
    class="inline-block no-underline transition-transform duration-(--duration-fast) ease-(--ease-standard) group-hover:translate-x-1 motion-reduce:transition-none"
  >
    →
  </span>
</a>
