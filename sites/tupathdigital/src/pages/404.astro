---
// Not-found page. Cloudflare Pages serves dist/404.html with status 404 for unknown paths.
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/sections/Footer.astro';
import { BUSINESS, PRIMARY, SECONDARY } from '../data/catalog';
---

<BaseLayout
  title="Page not found | tupathdigital"
  description="This page does not exist. Go back to the tupathdigital home page or open the Etsy and Gumroad stores."
  lang="en"
  noindex
>
  <header slot="header" class="bar-wrap">
    <div class="wrap">
      <a
        href="/"
        class="back"
        aria-label={`${BUSINESS}, back to the home page`}
      >
        <span>{BUSINESS}</span>
      </a>
    </div>
  </header>

  <section class="lost section-pad" aria-labelledby="lost-title">
    <div class="wrap">
      <p class="eyebrow">Error 404</p>
      <h1 id="lost-title">
        This page <em class="hl">does not exist</em>.
      </h1>
      <p class="sub">
        The link may be old or mistyped. Go back to the home page, or open one
        of the stores directly.
      </p>
      <div class="actions">
        <a class="btn btn-lg" href="/">
          Back to the home page
        </a>
        <a
          class="btn btn-lg btn-ghost"
          href={PRIMARY.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {PRIMARY.label}
        </a>
        <a
          class="btn btn-lg btn-ghost"
          href={SECONDARY.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {SECONDARY.label}
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .bar-wrap {
    padding-top: 1rem;
  }
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
  }
  .lost h1 {
    margin: 0.5rem 0 0;
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .sub {
    margin: 1.25rem 0 0;
    max-width: 34rem;
    color: var(--color-ink-soft);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
