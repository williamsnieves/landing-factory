---
// Footer of direction "a": sample contact data with its notice, the draft notice and the way back to the index.
import { site } from '../../../content/site';
import { footer } from './copy';
---

<footer class="border-line border-t px-4 sm:px-6">
  <div class="border-line mx-auto grid max-w-6xl gap-10 border-x px-5 py-14 text-sm sm:px-8 md:grid-cols-2 lg:px-12">
    <div>
      <p class="font-display text-lg font-medium tracking-tight">{site.name}</p>
      <p class="text-ink-soft mt-3 max-w-sm leading-relaxed">
        {site.draftNotice}
      </p>
      <a
        href="/"
        class="text-primary mt-6 inline-flex items-center gap-2 font-medium underline-offset-4 hover:underline"
      >
        <span aria-hidden="true">←</span>
        {footer.back}
      </a>
    </div>
    <div>
      <h2 class="text-ink-soft text-xs font-medium">{footer.contactTitle}</h2>
      <ul class="mt-3 space-y-1.5">
        <li>
          <a class="hover:text-primary" href={site.contact.phoneHref}>
            {site.contact.phone}
          </a>
        </li>
        <li>
          <a class="hover:text-primary" href={`mailto:${site.contact.email}`}>
            {site.contact.email}
          </a>
        </li>
        <li>{site.contact.address}</li>
        <li class="text-ink-soft">{site.contact.hours}</li>
      </ul>
      <p class="bg-surface text-ink-soft mt-5 rounded-sm px-3 py-2 text-xs leading-relaxed">
        {site.sampleNotice}
      </p>
    </div>
  </div>
</footer>
