---
/**
 * Documentación (`#docs`): an index of five topics with their mono path on the right. No link: the repository is
 * fictional (PROPOSAL.md, Decision 2), so the entry point is a visual-only element marked "demo".
 */
import SectionFrame from '../ui/SectionFrame.astro';
import MetaRow from '../ui/MetaRow.astro';
import DemoLink from '../ui/DemoLink.astro';
import { docs } from '../../content/site';
---

<SectionFrame
  id={docs.id}
  migration={docs.migration}
  title={docs.title}
  lead={docs.lead}
>
  <ul>
    {docs.rows.map((row, index) => (
      <MetaRow
        code={row.key}
        title={row.title}
        text={row.text}
        detail={row.detail}
        as="h3"
        delay={index * 0.05}
      />
    ))}
  </ul>
  <p
    class="text-ink-soft mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm"
    data-reveal
    data-reveal-y="10"
  >
    <span>{docs.note}</span>
    <DemoLink label={docs.open} />
  </p>
</SectionFrame>
