---
const steps = [
  {
    n: '01',
    title: 'Pick a product',
    text: 'Browse the catalog and open the listing in the store that sells it.',
  },
  {
    n: '02',
    title: 'Copy the code',
    text: 'Each store has its own code. Copy the one for the store you chose and enter it at checkout.',
  },
  {
    n: '03',
    title: 'Download instantly',
    text: 'Download straight from the store, or through the Google Drive link included with your purchase.',
  },
];
---

<section id="how" class="how section-pad" aria-labelledby="how-title">
  <div class="wrap">
    <div class="intro" data-reveal>
      <p class="eyebrow">How it works</p>
      <h2 id="how-title" class="h2">
        From the shelf to your <em class="hl">files</em>
      </h2>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step card" data-reveal data-reveal-delay={i * 0.1}>
          <span class="n">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .how {
    scroll-margin-top: 4.5rem;
  }
  .steps {
    display: grid;
    gap: 1rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .step {
    position: relative;
    padding: 1.75rem;
  }
  .n {
    display: inline-block;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.08em;
  }
  h3 {
    margin: clamp(1.5rem, 5vw, 2.5rem) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .step p {
    margin: 0.75rem 0 0;
    color: var(--color-ink-soft);
    text-wrap: pretty;
  }
  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
</style>
