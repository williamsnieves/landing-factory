---
// Typographic hero of direction "b": a narrow label column beside a huge flush-left headline, a ruled row with the
// line and the actions, then the stat strip. No image.
import ActionPair from './ActionPair.astro';
import Label from './Label.astro';
import StatStrip from './StatStrip.astro';
import { hero } from './copy';
---

<section id="b-hero" class="border-line border-b-2 px-4 sm:px-6">
  <div class="border-line mx-auto max-w-7xl border-x">
    <div class="grid lg:grid-cols-[14rem_1fr]">
      <div class="border-line flex justify-between gap-4 border-b px-4 py-3 sm:px-6 lg:flex-col lg:justify-start lg:border-r lg:border-b-0 lg:py-6">
        <Label>{hero.index}</Label>
        <Label class="text-ink-soft">{hero.place}</Label>
      </div>
      <div class="overflow-x-clip px-4 pt-6 pb-8 sm:px-6 lg:pt-10 lg:pb-12">
        <h1 class="font-display text-(length:--b-text-hero) leading-[0.95] font-extrabold tracking-tight uppercase">
          <span class="block">{hero.titleLead}</span>
          <span class="text-primary block">{hero.titleMark}</span>
        </h1>
      </div>
    </div>
    <div class="border-line grid border-t lg:grid-cols-[14rem_1fr]">
      <Label class="border-line text-ink-soft border-b px-4 py-3 sm:px-6 lg:border-r lg:border-b-0 lg:py-6">
        {hero.lineLabel}
      </Label>
      <div class="flex flex-col gap-6 px-4 py-6 sm:px-6 xl:flex-row xl:items-end xl:justify-between xl:gap-12">
        <p class="max-w-2xl text-lg leading-snug">{hero.line}</p>
        <div class="shrink-0">
          <ActionPair />
        </div>
      </div>
    </div>
    <StatStrip />
  </div>
</section>
