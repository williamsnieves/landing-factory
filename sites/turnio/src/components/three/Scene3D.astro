---
/**
 * Poster-first 3D scene. Renders the poster as real HTML; when JavaScript runs,
 * WebGL exists, reduced motion is not requested and the figure is near the
 * viewport, the runtime lazy-loads src/scenes/<scene>.ts (and Three.js) and
 * fades a canvas in over the poster. See README.md in this folder.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Module name: src/scenes/<scene>.ts. */
  scene: string;
  /** Static image of the scene; the LCP candidate and the no-JS fallback. */
  poster: ImageMetadata;
  /** Alternative text of the poster (the scene itself is aria-hidden). */
  alt: string;
  /** Drive the scene with the scroll progress (0..1) of the enclosing section. */
  scrub?: boolean;
  /** Load the poster eagerly with high priority (use for a hero scene). */
  priority?: boolean;
  /** CSS aspect ratio, e.g. "16/9" (default: the poster's own ratio). */
  aspect?: string;
  /** Poster `sizes` attribute. */
  sizes?: string;
  class?: string;
}

const scenes = import.meta.glob('/src/scenes/*.ts');
const {
  scene,
  poster,
  alt,
  scrub = false,
  priority = false,
  aspect,
  sizes = '100vw',
  class: className,
} = Astro.props;

if (!(`/src/scenes/${scene}.ts` in scenes)) {
  throw new Error(
    `<Scene3D scene="${scene}">: src/scenes/${scene}.ts does not exist (found: ${Object.keys(scenes).join(', ') || 'none'}).`,
  );
}
const ratio = aspect ?? `${poster.width}/${poster.height}`;
---

<figure
  data-scene={scene}
  data-scene-scrub={scrub ? '' : undefined}
  class:list={['scene3d relative m-0 overflow-hidden', className]}
  style={`aspect-ratio:${ratio}`}
>
  <Picture
    src={poster}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[640, 960, 1440, 1920]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
    class="block h-full w-full object-cover"
  />
  <div data-scene-mount aria-hidden="true" class="absolute inset-0"></div>
</figure>

<style is:global>
  .scene3d[data-scene-state='running'] > picture {
    opacity: 0;
    transition: opacity 0.7s ease 0.3s;
  }
</style>

<script>
  import type { SceneLoader } from './types';
  import { mountScenes, type ScenesHandle } from './runtime';

  const loaders = import.meta.glob('/src/scenes/*.ts') as Record<
    string,
    SceneLoader
  >;
  let handle: ScenesHandle | undefined;

  function mount() {
    if (handle) return;
    handle = mountScenes(loaders);
  }

  // View transitions: release GPU resources before the page is swapped out.
  document.addEventListener('astro:before-swap', () => {
    handle?.destroy();
    handle = undefined;
  });
  document.addEventListener('astro:page-load', mount);

  mount();
</script>
