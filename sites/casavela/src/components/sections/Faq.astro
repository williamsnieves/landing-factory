---
// Questions: native <details> in one column between hairlines (no JavaScript). Educational answers only; the fee
// answer says the fees are pending confirmation.
import { faq } from '../../content/page';
import TwoTone from '../ui/TwoTone.astro';
---

<section
  id="preguntas"
  class="border-line border-t px-4 sm:px-6"
  aria-labelledby="preguntas-titulo"
>
  <div class="border-line mx-auto grid max-w-6xl gap-10 border-x px-4 py-20 sm:px-8 lg:grid-cols-[4fr_7fr] lg:gap-16 lg:px-12 lg:py-28">
    <h2
      id="preguntas-titulo"
      class="font-display text-3xl leading-tight font-semibold tracking-tight text-balance lg:self-start"
      data-reveal
    >
      <TwoTone text={faq.title} />
    </h2>
    <div class="border-line border-t">
      {faq.items.map((item) => (
        <details class="group border-line border-b">
          <summary class="hover:text-primary flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-lg font-semibold transition-colors [&::-webkit-details-marker]:hidden">
            <span>{item.question}</span>
            <span
              aria-hidden="true"
              class="text-primary mt-0.5 shrink-0 text-xl leading-none transition-transform group-open:rotate-45"
            >
              +
            </span>
          </summary>
          <p class="text-ink max-w-prose pb-6 leading-relaxed">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
