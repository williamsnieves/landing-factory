---
// Hours card (warm-local-service's hours-card) with the page's twist: the split working day drawn as a one-day bar,
// the lunch gap visible, in HTML and CSS. The bar is decorative; the list under it is its text equivalent.
import { contact } from '../../content/page';
import { site } from '../../content/site';
import { daySegments, dayTicks } from '../../lib/hours';

const segments = daySegments(site.contact.spans);
const ticks = dayTicks();
---

<div class="bg-surface border-line rounded-lg border p-5 sm:p-6">
  <h3 class="text-xl font-semibold tracking-tight">{contact.hoursTitle}</h3>
  <p class="text-ink mt-1 text-base">
    {site.contact.days}. {contact.hoursLead}
  </p>
  <div class="mt-6" aria-hidden="true">
    <div class="bg-paper border-line rounded-pill relative h-10 border">
      {segments.map((segment) => (
        <span
          class="bg-primary rounded-pill absolute inset-y-1"
          style={`left: ${segment.left}%; width: ${segment.width}%`}
        />
      ))}
    </div>
    <div class="text-ink-soft relative mt-2 h-5 text-xs tabular-nums">
      {ticks.map((tick, index) => (
        <span
          class:list={['absolute top-0', index > 0 && '-translate-x-1/2']}
          style={`left: ${tick.left}%`}
        >
          {tick.label}
        </span>
      ))}
    </div>
  </div>
  <ul class="border-line mt-5 grid grid-cols-2 gap-4 border-t pt-4">
    {segments.map((segment) => (
      <li>
        <span class="text-ink-soft block text-sm">{segment.label}</span>
        <span class="block text-lg font-semibold tabular-nums">
          {segment.from}–{segment.to}
        </span>
      </li>
    ))}
  </ul>
</div>
