---
/**
 * Qué tratamos (PAS: Problem). 3 + 9 rows separated by thin rules: the number and a short title in the narrow
 * column, two plain sentences in the wide one. The last row (after an operation) carries the knee photo on four of
 * its nine columns, cropped from the left so the uniform sleeve at the right edge stays out.
 */
import PhotoFigure from '../ui/PhotoFigure.astro';
import kneePhoto from '../../assets/images/tratamos-rodilla.jpg';
import { exampleNotes, treatments } from '../../data/site';

const last = treatments.items.length - 1;
---

<section id="tratamos" aria-labelledby="tratamos-titulo" class="py-16 md:py-24">
  <div class="wrap">
    <div class="grid-12 gap-y-3" data-reveal>
      <h2
        id="tratamos-titulo"
        class="col-span-12 text-xl leading-tight font-semibold md:col-span-3"
      >
        {treatments.heading}
      </h2>
      <p class="col-span-12 max-w-[56ch] text-lg md:col-span-9">
        {treatments.intro}
      </p>
    </div>
    <ol class="mt-12 md:mt-16">
      {treatments.items.map((item, index) => (
        <li
          class="border-line grid-12 gap-y-4 border-t py-8 md:py-10"
          data-reveal
        >
          <div class="col-span-12 flex items-baseline gap-4 md:col-span-3">
            <span
              class="text-primary text-xl font-semibold tabular-nums"
              aria-hidden="true"
            >
              {item.number}
            </span>
            <h3 class="text-xl leading-tight font-semibold">{item.title}</h3>
          </div>
          <p
            class:list={[
              'col-span-12 max-w-[60ch] text-base',
              index === last
                ? 'md:col-span-9 lg:col-span-5'
                : 'md:col-span-9 lg:col-span-6',
            ]}
          >
            {item.text}
          </p>
          {index === last && (
            <PhotoFigure
              src={kneePhoto}
              alt={treatments.photoAlt}
              caption={exampleNotes.photo}
              crop="aspect-square object-[0%_50%]"
              widths={[360, 560, 720]}
              sizes="(min-width: 80rem) 23rem, (min-width: 64rem) 30vw, (min-width: 48rem) 60vw, 100vw"
              class="col-span-12 sm:col-span-8 md:col-start-4 md:col-span-6 lg:col-start-9 lg:col-span-4"
            />
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
