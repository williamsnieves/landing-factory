---
/**
 * A chat window with the salon's automatic reminder (no client name), and the deposit paid at booking
 * (Plan Pro). The bubble arrives after its frame: the page's one playful reveal.
 */
import MockFrame from '../ui/MockFrame.astro';
import { reminderChat } from '../../data/mocks';

interface Props {
  label: string;
  depositLabel: string;
}

const { label, depositLabel } = Astro.props;
---

<MockFrame label={label} class="w-full max-w-md overflow-hidden">
  <div class="border-line flex items-center gap-3 border-b px-5 py-4">
    <span class="bg-panel text-ink flex size-9 items-center justify-center rounded-pill text-sm font-medium">
      T
    </span>
    <div>
      <p class="text-ink text-sm font-medium">{reminderChat.contact}</p>
      <p class="text-ink-muted text-xs">{reminderChat.status}</p>
    </div>
  </div>
  <div class="bg-paper px-4 py-6 md:px-6 md:py-8">
    <p class="text-center">
      <span class="bg-surface text-ink-muted rounded-sm px-3 py-1 text-xs">
        {reminderChat.day}
      </span>
    </p>
    <div
      data-reveal
      data-reveal-delay="0.3"
      data-reveal-y="16"
      class="bg-surface border-line mt-5 max-w-[19rem] rounded-md rounded-tl-sm border p-4"
    >
      <p class="text-ink text-sm leading-relaxed">{reminderChat.message}</p>
      <p class="text-primary mt-2 text-sm font-medium underline underline-offset-2">
        {reminderChat.link}
      </p>
      <p class="text-ink-muted mt-2 text-right text-xs tabular-nums">
        {reminderChat.time}
      </p>
    </div>
    <p class="mt-5 flex justify-end">
      <span class="bg-primary-soft text-ink-soft flex items-center gap-2 rounded-sm px-3 py-2 text-xs">
        <span class="bg-primary size-2 rounded-pill"></span>
        {depositLabel}
      </span>
    </p>
  </div>
</MockFrame>
