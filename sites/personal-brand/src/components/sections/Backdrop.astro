---
// A decorative AI-generated background for a section (recorded in assets.json, disclosed in the footer).
// It sits behind the content, is hidden from assistive technology and carries a dark veil so text keeps its contrast.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /** Strength of the image under the veil, 0 to 1. */
  strength?: number;
  /** CSS object-position of the image. */
  position?: string;
  /** Above the fold: load at once, but never ahead of the content. */
  eager?: boolean;
}

const { src, strength = 0.6, position = 'center', eager = false } = Astro.props;
---

<div class="backdrop" aria-hidden="true">
  <Image
    src={src}
    alt=""
    widths={[768, 1280, 1920]}
    sizes="100vw"
    quality={70}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority="low"
    decoding="async"
    style={`--backdrop-strength: ${strength}; object-position: ${position};`}
  />
</div>

<style>
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .backdrop img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: var(--backdrop-strength);
  }
  /* The veil: darker toward the edges, so headings and body text stay above 4.5:1. */
  .backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--color-paper) 45%, transparent),
      color-mix(in oklab, var(--color-paper) 20%, transparent) 40%,
      color-mix(in oklab, var(--color-paper) 55%, transparent)
    );
  }
</style>
