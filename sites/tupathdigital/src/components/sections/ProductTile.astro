---
import { Image } from 'astro:assets';
import type { Product } from '../../data/catalog';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const { cover, stores } = product;
const headline = stores[0];
const sizes = '(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw';
---

<article class="tile card">
  <div class="cover">
    <Image
      src={cover}
      alt={product.alt}
      widths={[360, 600, 800]}
      sizes={sizes}
      format="webp"
      quality={80}
      loading="lazy"
    />
  </div>
  <div class="info">
    <h3>{headline.title}</h3>
    <ul class="tags" aria-label="Formats and details from the listing">
      {product.tags.map((t) => (
        <li class="tag">{t}</li>
      ))}
    </ul>
    {stores.map((s, i) => (
      <div class="buy">
        {i > 0 && (
          <p class="own-title">
            <span>{s.name} listing:</span> {s.title}
          </p>
        )}
        <div class="row">
          <p class="price">
            <strong>{s.price}</strong> <span>on {s.name}</span>
          </p>
          <a
            class="btn btn-sm"
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`View on ${s.name}: ${s.title}`}
          >
            View on {s.name}
          </a>
        </div>
      </div>
    ))}
  </div>
</article>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: border-color var(--duration-base) var(--ease-out);
  }
  @media (hover: hover) {
    .tile:hover {
      border-color: color-mix(
        in oklab,
        var(--color-primary) 70%,
        var(--color-line)
      );
    }
    .tile:hover .cover :global(img) {
      scale: 1.03;
    }
  }
  /* The whole cover is shown (never cropped) on a soft blue spotlight; the
     stage grows when a neighbour card is taller, so no card has an empty gap. */
  .cover {
    position: relative;
    flex: 1 1 auto;
    aspect-ratio: 1 / 1;
    border-bottom: 1px solid var(--color-line);
    background:
      radial-gradient(
        closest-side,
        color-mix(in oklab, var(--color-primary) 22%, transparent),
        transparent 100%
      ),
      var(--color-paper);
    overflow: hidden;
  }
  .cover :global(img) {
    position: absolute;
    inset: 1rem;
    width: calc(100% - 2rem);
    height: calc(100% - 2rem);
    object-fit: contain;
    transition: scale 0.6s var(--ease-out);
  }
  .info {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem 1.25rem 1.5rem;
  }
  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.35;
    text-wrap: pretty;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .buy {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .own-title {
    margin: 0.25rem 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-xs);
    line-height: 1.4;
  }
  .own-title span {
    color: var(--color-ink);
    font-weight: 600;
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }
  .price {
    margin: 0;
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .price strong {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .price span {
    color: var(--color-ink-soft);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
</style>
