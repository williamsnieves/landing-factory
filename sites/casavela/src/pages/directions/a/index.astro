---
// Visual direction "a" (noindex): product-like clarity, a split hero and a sticky mortgage calculator.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CalculatorSection from '../../../components/directions/a/CalculatorSection.astro';
import Footer from '../../../components/directions/a/Footer.astro';
import Header from '../../../components/directions/a/Header.astro';
import Hero from '../../../components/directions/a/Hero.astro';
import StatStrip from '../../../components/directions/a/StatStrip.astro';
import { meta } from '../../../components/directions/a/copy';
import '../../../styles/directions/a.css';
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  lang="es"
  skipLabel="Saltar al contenido"
  noindex
>
  <div slot="header" data-direction="a" class="bg-paper text-ink font-sans">
    <Header />
  </div>
  <div data-direction="a" class="bg-paper text-ink font-sans min-h-screen">
    <Hero />
    <StatStrip />
    <CalculatorSection />
  </div>
  <div slot="footer" data-direction="a" class="bg-paper text-ink font-sans">
    <Footer />
  </div>
</BaseLayout>
