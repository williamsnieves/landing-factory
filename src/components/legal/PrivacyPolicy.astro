---
// These templates support compliance and are not legal advice. See texts.ts.
// Privacy policy, rendered from src/data/legal.json (node scripts/legal.mjs --site <slug> --write).
import LegalValue from './LegalValue.astro';
import {
  formsProcessing,
  privacyEmail,
  textsFor,
  type LegalData,
} from './texts';

interface Props {
  data: LegalData;
  /** Multi-locale sites: the locale to write the page in (default: Astro.currentLocale, else the data's language). */
  locale?: string;
  /** Link to the legal notice page, when the site has one. */
  noticeHref?: string;
}
const { data, noticeHref, locale = Astro.currentLocale } = Astro.props;
const t = textsFor(data, locale);
const p = t.privacy;
const fields = ['name', 'taxId', 'address', 'email'] as const;
// Name and email always show; the tax id and address show when given or required.
const rows = fields.filter(
  (field) =>
    field === 'name' ||
    data.holder[field] ||
    data.pending.includes(`holder.${field}`),
);
const analytics = data.processing.analytics as
  'none' | 'cookieless' | 'cookies';
const host = data.hosting.name || p.hostFallback;
const contact = privacyEmail(data);
const forms = formsProcessing(data);
const contactField = data.pending.includes('privacyContact')
  ? 'privacyContact'
  : 'holder.email';
---

<article
  data-legal-page="privacy"
  class="mx-auto max-w-3xl px-6 py-16 md:py-24"
>
  <h1 class="font-display text-3xl">{p.title}</h1>

  <h2 class="font-display mt-12 text-xl">{p.controllerHeading}</h2>
  <p class="text-ink-soft mt-3">{p.controllerIntro}</p>
  <dl class="mt-4 grid gap-x-8 gap-y-2 sm:grid-cols-[14rem_1fr]">
    {rows.map((field) => (
      <>
        <dt class="text-ink-soft">{p.labels[field]}</dt>
        <dd>
          <LegalValue
            value={data.holder[field]}
            field={`holder.${field}`}
            pending={t.pending}
          />
        </dd>
      </>
    ))}
  </dl>

  <h2 class="font-display mt-12 text-xl">{p.dataHeading}</h2>
  <ul class="text-ink-soft mt-3 list-disc space-y-3 pl-6">
    <li>{p.logs(host)}</li>
    <li>
      {analytics in p.analytics ? (
        p.analytics[analytics]
      ) : (
        <>
          {p.analyticsLabel}:{' '}
          <LegalValue
            value=""
            field="processing.analytics"
            pending={t.pending}
          />
        </>
      )}
    </li>
    {data.processing.forms && <li>{p.forms}</li>}
    {forms && p.formsProviders(forms).map((text) => <li>{text}</li>)}
    {data.processing.embeds.length > 0 && (
      <li>{p.embeds(data.processing.embeds.join(', '))}</li>
    )}
  </ul>

  {data.thirdPartyHosts.length > 0 && (
    <>
      <h2 class="font-display mt-12 text-xl">{p.hostsHeading}</h2>
      <p class="text-ink-soft mt-3">
        {p.hosts(data.thirdPartyHosts.join(', '))}
      </p>
    </>
  )}

  <h2 class="font-display mt-12 text-xl">{p.rightsHeading}</h2>
  <p class="text-ink-soft mt-3">{p.rights}</p>
  <p class="text-ink-soft mt-3">{p.complaint(data.markets)}</p>

  <h2 class="font-display mt-12 text-xl">{p.contactHeading}</h2>
  <p class="text-ink-soft mt-3">
    {p.contact}{' '}
    <LegalValue value={contact} field={contactField} pending={t.pending} />
  </p>

  {noticeHref && (
    <p class="mt-12">
      <a href={noticeHref} class="underline underline-offset-4">
        {p.noticeLink}
      </a>
    </p>
  )}
</article>
