---
import Chapter from '../Chapter.astro';
import Cta from '../Cta.astro';
import Photo from '../Photo.astro';
import photoStair from '../../assets/images/escalera.jpg';
import { site } from '../../data/site';
---

<section
  id="contacto"
  class="border-line scroll-mt-4 border-t"
  aria-labelledby="contacto-title"
>
  <Photo
    src={photoStair}
    alt=""
    ratio="3 / 1"
    position="50% 40%"
    sizes="100vw"
    class="contacto-photo"
  />
  <div class="wrap grid grid-cols-12 gap-x-4 gap-y-8 py-24 md:gap-x-6 md:py-40">
    <div class="col-span-12 md:col-span-3">
      <Chapter n="VI" label="Contacto" />
    </div>
    <div class="col-span-12 md:col-span-9">
      <h2
        id="contacto-title"
        class="font-display max-w-[20ch] text-4xl leading-[1.1] font-medium tracking-tight text-balance"
        data-reveal
      >
        Cuéntenos qué edificio, qué espacio y para cuándo.
      </h2>
      <div class="mt-10" data-reveal>
        <Cta />
      </div>

      <dl
        class="border-line mt-16 grid gap-x-6 gap-y-8 border-t pt-6 md:grid-cols-3"
        data-reveal
      >
        <div>
          <dt class="text-ink-soft text-sm">Correo</dt>
          <dd class="mt-2">
            <a class="link" href={`mailto:${site.email}`}>
              {site.email}
            </a>
          </dd>
        </div>
        <div>
          <dt class="text-ink-soft text-sm">Teléfono</dt>
          <dd class="mt-2 tabular-nums">
            <a class="link" href={site.phoneHref}>
              {site.phone}
            </a>
          </dd>
          <dd class="text-ink-soft mt-1 text-sm">{site.hours}</dd>
        </div>
        <div>
          <dt class="text-ink-soft text-sm">Estudio</dt>
          <dd class="mt-2">
            {site.addressLines.map((l) => (
              <span class="block">{l}</span>
            ))}
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .contacto-photo {
    border-radius: 0;
  }
  @media (max-width: 767px) {
    .contacto-photo {
      aspect-ratio: 16 / 9 !important;
    }
  }
</style>
