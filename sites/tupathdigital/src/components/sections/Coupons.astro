---
import { COUPONS, COUPON_END } from '../../data/catalog';

const tickets = [
  { store: 'Etsy' as const, ...COUPONS.Etsy },
  { store: 'Gumroad' as const, ...COUPONS.Gumroad },
];
---

<section
  id="coupons"
  class="coupons section-pad glow-left"
  aria-labelledby="coupons-title"
>
  <div class="wrap">
    <div class="intro" data-reveal>
      <h2 id="coupons-title">Two stores, two codes</h2>
      <p>
        Each code takes 50% off the listed price in its own store, until{' '}
        {COUPON_END}. Copy it, open the store and use it on any product.
      </p>
    </div>
    <div class="tickets">
      {tickets.map((t, i) => (
        <article class="ticket" data-reveal data-reveal-delay={i * 0.12}>
          <div class="main">
            <p class="store">{t.store}</p>
            <p class="code">
              <code>{t.code}</code>
            </p>
            <p class="terms">50% off the listed price, until {COUPON_END}</p>
          </div>
          <div class="stub">
            <button
              type="button"
              class="btn copy"
              data-copy={t.code}
              hidden
              aria-label={`Copy code ${t.code}`}
            >
              Copy code
            </button>
            <a
              class="link-arrow"
              href={t.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              Shop on {t.store}
            </a>
          </div>
        </article>
      ))}
    </div>
    <p
      class="status sr-only"
      role="status"
      aria-live="polite"
      id="copy-status"
    ></p>
  </div>
</section>

<style>
  .coupons {
    scroll-margin-top: 4.5rem;
  }
  .intro {
    max-width: 40rem;
    margin-bottom: 2rem;
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .intro p {
    margin: 1rem 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-lg);
    line-height: 1.5;
  }
  .tickets {
    display: grid;
    gap: 1rem;
  }
  .ticket {
    --notch: 0.9rem;
    --stub: 8.5rem;
    display: grid;
    grid-template-rows: 1fr auto;
    background: var(--color-surface);
    outline: 1px solid var(--color-line);
    outline-offset: -1px;
    border-radius: var(--radius-tile);
    /* Notches where the stub tears off: left and right edges on a phone. */
    -webkit-mask:
      radial-gradient(
          circle var(--notch) at 0 calc(100% - var(--stub)),
          #0000 96%,
          #000
        )
        left / 51% 100% no-repeat,
      radial-gradient(
          circle var(--notch) at 100% calc(100% - var(--stub)),
          #0000 96%,
          #000
        )
        right / 51% 100% no-repeat;
    mask:
      radial-gradient(
          circle var(--notch) at 0 calc(100% - var(--stub)),
          #0000 96%,
          #000
        )
        left / 51% 100% no-repeat,
      radial-gradient(
          circle var(--notch) at 100% calc(100% - var(--stub)),
          #0000 96%,
          #000
        )
        right / 51% 100% no-repeat;
  }
  .main {
    padding: 1.5rem;
  }
  .store {
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .code {
    margin: 0.5rem 0 0;
  }
  .code code {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: 0.02em;
    word-break: break-all;
    user-select: all;
  }
  .terms {
    margin: 0.5rem 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }
  .stub {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 0.5rem;
    min-height: var(--stub);
    padding: 1rem 1.5rem;
    border-top: 2px dashed var(--color-line);
  }
  .copy[hidden] {
    display: none;
  }
  .copy[data-done='true'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
  @media (min-width: 900px) {
    .tickets {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }
  @media (min-width: 520px) {
    .ticket {
      grid-template-rows: none;
      grid-template-columns: 1fr 13rem;
      --stub: 13rem;
      -webkit-mask:
        radial-gradient(
            circle var(--notch) at calc(100% - var(--stub)) 0,
            #0000 96%,
            #000
          )
          top / 100% 51% no-repeat,
        radial-gradient(
            circle var(--notch) at calc(100% - var(--stub)) 100%,
            #0000 96%,
            #000
          )
          bottom / 100% 51% no-repeat;
      mask:
        radial-gradient(
            circle var(--notch) at calc(100% - var(--stub)) 0,
            #0000 96%,
            #000
          )
          top / 100% 51% no-repeat,
        radial-gradient(
            circle var(--notch) at calc(100% - var(--stub)) 100%,
            #0000 96%,
            #000
          )
          bottom / 100% 51% no-repeat;
    }
    .stub {
      min-height: 0;
      border-top: 0;
      border-left: 2px dashed var(--color-line);
    }
    .main {
      padding: 2rem;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-copy]');
  const status = document.getElementById('copy-status');

  async function copy(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // Fallback for browsers without the async clipboard API.
      const field = document.createElement('textarea');
      field.value = text;
      field.setAttribute('readonly', '');
      field.style.position = 'fixed';
      field.style.opacity = '0';
      document.body.appendChild(field);
      field.select();
      let ok = false;
      try {
        ok = document.execCommand('copy');
      } catch {
        ok = false;
      }
      field.remove();
      return ok;
    }
  }

  buttons.forEach((button) => {
    button.hidden = false;
    const label = button.textContent ?? 'Copy code';
    button.addEventListener('click', async () => {
      const code = button.dataset.copy ?? '';
      const ok = await copy(code);
      button.textContent = ok ? 'Copied' : 'Press Ctrl+C';
      button.dataset.done = ok ? 'true' : 'false';
      if (status) status.textContent = ok ? `Copied ${code}` : '';
      window.setTimeout(() => {
        button.textContent = label;
        delete button.dataset.done;
      }, 1800);
    });
  });
</script>
