---
// Visual direction "c" (noindex): "de barrio". Warm local-service grammar: a full-bleed photo of a Valencia
// street with a solid panel for the headline, the practical facts (where, when, how) and a stat strip right
// under it, and the three services beside the service area and an hours card.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/directions/c/Footer.astro';
import Header from '../../../components/directions/c/Header.astro';
import Hero from '../../../components/directions/c/Hero.astro';
import Practical from '../../../components/directions/c/Practical.astro';
import Services from '../../../components/directions/c/Services.astro';
import { meta } from '../../../components/directions/c/copy';
import '../../../styles/directions/c.css';
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  lang="es"
  skipLabel="Saltar al contenido"
  noindex
>
  <div slot="header" data-direction="c" class="bg-paper text-ink font-sans">
    <Header />
  </div>
  <div data-direction="c" class="bg-paper text-ink font-sans min-h-screen">
    <Hero />
    <Practical />
    <Services />
  </div>
  <div slot="footer" data-direction="c" class="bg-paper text-ink font-sans">
    <Footer />
  </div>
</BaseLayout>
