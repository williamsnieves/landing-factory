---
// Stat strip of direction "c" (trait `stat-strip` lent by data-and-proof): three figures on an olive band, each
// with its unit, a label and its source. Brief facts only; sample values say so. Medium figures, not giant
// numerals (warm-local-service rejects those).
import { practical, stats } from './copy';
---

<div class="bg-primary text-primary-contrast rounded-lg p-6 sm:p-8">
  <h3 class="text-sm font-bold">{practical.statsTitle}</h3>
  <dl class="mt-4 grid gap-6 md:grid-cols-3 md:gap-8">
    {stats.map((stat) => (
      <div class="flex flex-col border-t border-current/30 pt-4">
        <dt class="order-2 mt-1 text-base leading-snug">{stat.label}</dt>
        <dd class="font-display order-1 flex items-baseline gap-2 leading-none">
          <span class="text-3xl tabular-nums">{stat.figure}</span>
          <span class="text-xl">{stat.unit}</span>
        </dd>
        <dd class="order-3 mt-2 text-xs leading-snug">{stat.source}</dd>
      </div>
    ))}
  </dl>
</div>
