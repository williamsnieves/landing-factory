---
import { COUPON_END, productCount, storeCount } from '../../data/catalog';

const figures = [
  {
    value: String(productCount),
    label: 'Products',
    note: 'Guides, packs and bundles',
  },
  { value: String(storeCount), label: 'Stores', note: 'Etsy and Gumroad' },
  {
    value: '50%',
    label: 'Off with a code',
    note: `Until ${COUPON_END}`,
  },
  {
    value: 'Instant',
    label: 'Download',
    note: 'Right after purchase',
  },
];
---

<section class="figures" aria-label="The catalog in numbers">
  <div class="wrap">
    <dl class="row">
      {figures.map((f, i) => (
        <div class="fig card" data-reveal data-reveal-delay={i * 0.08}>
          <dt class="label">{f.label}</dt>
          <dd class="value">{f.value}</dd>
          <dd class="note">{f.note}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .figures {
    padding-block: clamp(2.5rem, 5vw, 4rem) 0;
  }
  .row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin: 0;
  }
  .fig {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
  }
  .value {
    order: 1;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-2xl);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .label {
    order: 2;
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .note {
    order: 3;
    margin: 0.35rem 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }
  @media (min-width: 900px) {
    .row {
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    .fig {
      padding: 1.75rem;
    }
    .value {
      font-size: var(--text-3xl);
    }
  }
</style>
