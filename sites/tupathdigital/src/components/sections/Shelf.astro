---
import type { Shelf } from '../../data/catalog';
import ProductTile from './ProductTile.astro';
import { COUPONS, COUPON_END } from '../../data/catalog';

interface Props {
  shelf: Shelf;
}
const { shelf } = Astro.props;
const products = shelf.items.filter((i) => !('coupon' in i));
const titleId = `${shelf.id}-title`;
---

<section id={shelf.id} class="shelf" aria-labelledby={titleId}>
  <div class="wrap">
    <div class="grid">
      <header
        class="tile head"
        style={`--c:${shelf.head.cols};--r:${shelf.head.rows}`}
        data-reveal
      >
        <p class="count">
          <span>{products.length}</span> products
        </p>
        <div>
          <h2 id={titleId}>{shelf.name}</h2>
          <p class="blurb">{shelf.blurb}</p>
        </div>
      </header>
      {shelf.items.map((item, i) =>
        'coupon' in item ? (
          <aside
            class="tile promo"
            style={`--c:${item.cols};--r:${item.rows}`}
            data-reveal
            data-reveal-delay={((i + 1) % 4) * 0.08}
          >
            <p class="big">50% off</p>
            <p>
              Every product, with <b>{COUPONS.Etsy.code}</b> on Etsy or{' '}
              <b>{COUPONS.Gumroad.code}</b> on Gumroad, until {COUPON_END}.
            </p>
            <a href="#coupons" class="link-arrow">
              Copy a code
            </a>
          </aside>
        ) : (
          <ProductTile product={item} delay={((i + 1) % 4) * 0.08} />
        ),
      )}
    </div>
  </div>
</section>

<style>
  .shelf {
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    scroll-margin-top: 4.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  .tile {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-tile);
    overflow: hidden;
  }
  .head {
    justify-content: space-between;
    gap: 2.5rem;
    padding: 1.5rem;
    background: color-mix(
      in oklab,
      var(--color-primary) 18%,
      var(--color-surface)
    );
    border-color: color-mix(
      in oklab,
      var(--color-primary) 45%,
      var(--color-line)
    );
  }
  .count {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .count span {
    letter-spacing: -0.04em;
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .blurb {
    margin: 0.9rem 0 0;
    max-width: 30rem;
    color: var(--color-ink);
    font-size: var(--text-base);
    line-height: 1.5;
  }
  .promo {
    justify-content: center;
    gap: 0.9rem;
    padding: 1.5rem;
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-primary-contrast);
  }
  .promo p {
    margin: 0;
  }
  .promo .big {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .promo .link-arrow {
    color: var(--color-primary-contrast);
    font-weight: 600;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    .head {
      grid-column: span 2;
    }
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 19rem;
      grid-auto-flow: dense;
    }
    .head,
    .promo {
      grid-column: span var(--c);
      grid-row: span var(--r);
    }
    .head {
      padding: 2rem;
    }
  }
</style>
