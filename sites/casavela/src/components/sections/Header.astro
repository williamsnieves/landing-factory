---
// Header inside the hairline rails: name left; section links, the phone and the primary action right. Below
// 1024 px the links collapse into a native <details> menu (works without JavaScript) and the phone becomes an
// icon link.
import { header } from '../../content/page';
import { site } from '../../content/site';
---

<header class="border-line border-b px-4 sm:px-6">
  <div class="border-line mx-auto flex max-w-6xl items-center justify-between gap-3 border-x px-4 py-3 sm:px-8 lg:px-12">
    <a
      href="/"
      class="flex min-w-0 flex-col leading-tight"
      aria-label={header.homeLabel}
    >
      <span class="font-display text-lg font-semibold tracking-tight">
        {header.nameFirst}
      </span>
      <span class="text-ink-soft text-xs"> {header.nameSecond}</span>
    </a>

    <nav aria-label="Secciones" class="hidden lg:block">
      <ul class="flex items-center gap-7 text-sm font-medium">
        {header.nav.map((link) => (
          <li>
            <a
              href={link.href}
              class="hover:text-primary underline-offset-4 transition-colors hover:underline"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={site.contact.phoneHref}
        class="hover:text-primary hidden text-sm font-medium tabular-nums transition-colors md:inline"
      >
        {site.contact.phone}
      </a>
      <a
        href={site.contact.phoneHref}
        aria-label={header.callLabel}
        class="border-line hover:border-primary hover:text-primary flex size-11 items-center justify-center rounded-pill border transition-colors md:hidden"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="size-5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path>
        </svg>
      </a>
      <a
        href={site.primary.href}
        class="bg-primary text-primary-contrast hover:bg-primary-hover inline-flex min-h-11 items-center rounded-pill px-4 text-sm font-medium transition-colors"
      >
        <span class="sm:hidden">{header.ctaShort}</span>
        <span class="hidden sm:inline">{header.cta}</span>
      </a>
      <details class="group relative lg:hidden">
        <summary
          aria-label={header.menuLabel}
          class="border-line hover:border-primary flex size-11 cursor-pointer list-none items-center justify-center rounded-pill border transition-colors [&::-webkit-details-marker]:hidden"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="size-5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          >
            <path class="group-open:hidden" d="M4 7h16M4 12h16M4 17h16"></path>
            <path
              class="hidden group-open:block"
              d="M6 6l12 12M18 6 6 18"
            ></path>
          </svg>
        </summary>
        <nav
          aria-label="Menú de secciones"
          class="bg-paper border-line absolute top-full right-0 z-20 mt-2 w-56 rounded-md border p-2"
        >
          <ul class="text-base">
            {header.nav.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="hover:bg-surface block rounded-sm px-3 py-2.5"
                >
                  {link.label}
                </a>
              </li>
            ))}
            <li class="border-line mt-1 border-t pt-1">
              <a
                href={site.contact.phoneHref}
                class="hover:bg-surface block rounded-sm px-3 py-2.5 tabular-nums"
              >
                {site.contact.phone}
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
