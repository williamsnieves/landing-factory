---
/**
 * Hero (PAS: Problem). Split 7 + 5 on the twelve-column grid: the h1 with the keyword and the lead flush left on
 * seven columns with the primary and the quiet secondary action; one rectangular illustrative photo on five. No
 * reveal on the h1 or on the photo (the LCP candidate).
 */
import PhotoFigure from '../ui/PhotoFigure.astro';
import ActionLink from '../ui/ActionLink.astro';
import PhoneLink from '../ui/PhoneLink.astro';
import heroPhoto from '../../assets/images/hero-tratamiento-pierna.jpg';
import {
  contact,
  exampleNotes,
  hero,
  primaryAction,
  secondaryAction,
} from '../../data/site';
---

<section
  id="inicio"
  aria-labelledby="inicio-titulo"
  class="pt-10 pb-12 md:pt-16 md:pb-20"
>
  <div class="wrap grid-12 items-center gap-y-10">
    <div class="col-span-12 md:col-span-7 md:pr-6 lg:pr-12">
      <h1 id="inicio-titulo" class="text-3xl leading-[1.15] font-semibold">
        {hero.heading}
      </h1>
      <p class="mt-6 max-w-[38ch] text-lg font-semibold">{hero.lead}</p>
      <p class="mt-3 max-w-[58ch] text-base">{hero.text}</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-3">
        <ActionLink href={primaryAction.href} label={primaryAction.label} />
        <PhoneLink
          label={secondaryAction.label}
          phone={contact.phone}
          href={secondaryAction.href}
        />
      </div>
    </div>
    <PhotoFigure
      src={heroPhoto}
      alt={hero.photoAlt}
      caption={exampleNotes.photo}
      crop="aspect-[4/5] object-[28%_50%]"
      widths={[400, 640, 800, 1000]}
      sizes="(min-width: 80rem) 30rem, (min-width: 48rem) 40vw, 100vw"
      priority
      class="col-span-12 md:col-span-5"
    />
  </div>
</section>
