---
// Stat strip of direction "b": three ruled cells, each figure with its unit, a label and a mono source line.
// Brief facts only; sample values say so.
import Label from './Label.astro';
import { stats, statsLabel } from './copy';
---

<div class="border-line border-t">
  <Label class="text-ink-soft border-line border-b px-4 py-3 sm:px-6">
    {statsLabel}
  </Label>
  <dl class="grid md:grid-cols-3">
    {stats.map((stat) => (
      <div class="border-line flex flex-col border-b last:border-b-0 md:border-r md:border-b-0 md:last:border-r-0">
        <dt class="text-ink-soft order-2 px-4 pt-2 pb-4 text-base leading-snug sm:px-6">
          {stat.label}
        </dt>
        <dd class="font-display order-1 flex flex-wrap items-baseline gap-x-3 px-4 pt-5 leading-none font-extrabold uppercase sm:px-6">
          <span class="text-(length:--b-text-figure) tabular-nums">
            {stat.figure}
          </span>
          <span class="text-xl">{stat.unit}</span>
        </dd>
        <dd class="border-line order-3 mt-auto border-t px-4 py-3 sm:px-6">
          <Label as="span" class="text-ink-soft">
            {stat.source}
          </Label>
        </dd>
      </div>
    ))}
  </dl>
</div>
