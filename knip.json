{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/scenes/*.ts",
        "src/components/forms/client.ts",
        "scripts/**/*.mjs",
        "tests/**/*.mjs"
      ],
      "project": [
        "src/**/*.{astro,ts,tsx,css}",
        "scripts/**/*.mjs",
        "tests/**/*.mjs"
      ],
      "ignore": ["src/components/legal/**", "src/components/i18n/**"],
      "ignoreDependencies": ["eslint-plugin-jsx-a11y"]
    },
    "sites/*": {
      "entry": [
        "src/i18n/urls.ts",
        "src/scenes/*.ts",
        "src/components/forms/client.ts"
      ],
      "project": ["src/**/*.{astro,ts,tsx,css}"],
      "ignore": [
        "src/components/three/**",
        "src/components/legal/**",
        "src/components/forms/**"
      ]
    }
  }
}
