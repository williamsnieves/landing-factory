{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "OPENSPEC_TELEMETRY": "0"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npx astro *)",
      "Bash(npx impeccable *)",
      "Bash(npx playwright *)",
      "Bash(npx prettier *)",
      "Bash(openspec *)",
      "Bash(bash scripts/setup-agent.sh *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/setup-agent.sh\" --verify",
            "timeout": 15,
            "statusMessage": "Verifying agent tooling"
          }
        ]
      }
    ]
  }
}
