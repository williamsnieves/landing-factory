---
import { Image } from 'astro:assets';
import type { Product, Shelf } from '../../data/catalog';
import ProductTile from './ProductTile.astro';
import { COUPONS, COUPON_END } from '../../data/catalog';

interface Props {
  shelf: Shelf;
}
const { shelf } = Astro.props;
const products = shelf.items.filter((i): i is Product => !('coupon' in i));
// Decorative preview: up to three covers of this shelf, fanned.
const previews = products.slice(0, 3);
const titleId = `${shelf.id}-title`;
---

<section id={shelf.id} class="shelf" aria-labelledby={titleId}>
  <div class="wrap">
    <div class="grid">
      <header
        class:list={['tile head', { wide: shelf.head.cols === 4 }]}
        style={`--c:${shelf.head.cols};--r:${shelf.head.rows}`}
        data-reveal
      >
        <p class="count">
          <span>{products.length}</span> products
        </p>
        <div class="text">
          <h2 id={titleId}>{shelf.name}</h2>
          <p class="blurb">{shelf.blurb}</p>
        </div>
        <div class={`fan n${previews.length}`} aria-hidden="true">
          {previews.map((p) => (
            <Image
              src={p.cover}
              alt=""
              width={240}
              densities={[1, 2]}
              format="webp"
              quality={75}
              loading="lazy"
              decoding="async"
            />
          ))}
        </div>
      </header>
      {shelf.items.map((item, i) =>
        'coupon' in item ? (
          <aside
            class="tile promo"
            style={`--c:${item.cols};--r:${item.rows}`}
            data-reveal
            data-reveal-delay={((i + 1) % 4) * 0.08}
          >
            <p class="big">50% off</p>
            <p>
              Every product, with <b>{COUPONS.Etsy.code}</b> on Etsy or{' '}
              <b>{COUPONS.Gumroad.code}</b> on Gumroad, until {COUPON_END}.
            </p>
            <a href="#coupons" class="link-arrow">
              Copy a code
            </a>
          </aside>
        ) : (
          <ProductTile product={item} delay={((i + 1) % 4) * 0.08} />
        ),
      )}
    </div>
  </div>
</section>

<style>
  .shelf {
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    scroll-margin-top: 4.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  .tile {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-tile);
    overflow: hidden;
  }
  .head {
    gap: 1.5rem;
    padding: 1.75rem 1.5rem 1.5rem;
    background: color-mix(
      in oklab,
      var(--color-primary) 18%,
      var(--color-surface)
    );
    border-color: color-mix(
      in oklab,
      var(--color-primary) 45%,
      var(--color-line)
    );
  }
  .count {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .count span {
    letter-spacing: -0.04em;
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .blurb {
    margin: 0.9rem 0 0;
    max-width: 30rem;
    color: var(--color-ink);
    font-size: var(--text-base);
    line-height: 1.5;
  }
  .text {
    min-width: 0;
  }
  /* Fanned covers fill the middle of the tile (decorative). */
  .fan {
    position: relative;
    flex: 1 1 auto;
    min-height: 11rem;
  }
  .fan :global(img) {
    position: absolute;
    top: 50%;
    left: 50%;
    height: 88%;
    width: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 50% 0;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in oklab, var(--color-ink) 18%, transparent);
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.35);
    pointer-events: none;
    translate: -50% -50%;
  }
  .fan :global(img:nth-child(1)) {
    rotate: -9deg;
    translate: calc(-50% - 5.5rem) -48%;
  }
  .fan :global(img:nth-child(2)) {
    rotate: 0deg;
    z-index: 1;
  }
  .fan :global(img:nth-child(3)) {
    rotate: 9deg;
    translate: calc(-50% + 5.5rem) -48%;
  }
  .fan.n2 :global(img:nth-child(1)) {
    translate: calc(-50% - 3rem) -48%;
  }
  .fan.n2 :global(img:nth-child(2)) {
    rotate: 8deg;
    translate: calc(-50% + 3rem) -50%;
  }
  .promo {
    justify-content: center;
    gap: 0.9rem;
    padding: 1.75rem 1.5rem;
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-primary-contrast);
  }
  .promo p {
    margin: 0;
  }
  .promo .big {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .promo .link-arrow {
    color: var(--color-primary-contrast);
    font-weight: 600;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    .head {
      grid-column: span 2;
    }
    .head.wide {
      flex-direction: row;
      align-items: center;
    }
    .head.wide .text {
      flex: 1 1 50%;
    }
    .head.wide .fan {
      flex: 1 1 50%;
      align-self: stretch;
    }
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 19rem;
      grid-auto-flow: dense;
    }
    .head,
    .promo {
      grid-column: span var(--c);
      grid-row: span var(--r);
    }
    .head {
      padding: 2.25rem 2rem 2rem;
    }
    .head.wide {
      padding-block: 2rem;
    }
    .fan {
      min-height: 14rem;
    }
    .head.wide .fan {
      min-height: 0;
    }
  }
</style>
