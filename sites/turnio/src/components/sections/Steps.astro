---
/** How to start: a centered heading over three hairline-divided columns with mono step labels (an ordered list). No time claims. */
import Container from '../ui/Container.astro';
import TwoTone from '../ui/TwoTone.astro';
import MonoLabel from '../ui/MonoLabel.astro';
import { steps } from '../../content/site';

const delays = ['0', '0.08', '0.16'];
---

<section
  id={steps.id}
  aria-labelledby={`${steps.id}-titulo`}
  class="scroll-mt-20 pt-28 md:pt-36 lg:pt-44"
>
  <Container>
    <div data-reveal>
      <TwoTone
        text={steps.heading}
        id={`${steps.id}-titulo`}
        class="mx-auto max-w-3xl text-center text-2xl leading-[1.1] font-medium tracking-[-0.015em] text-balance"
      />
    </div>
    <ol class="mt-10 grid md:mt-14 md:grid-cols-3">
      {steps.items.map((step, index) => (
        <li
          data-reveal
          data-reveal-delay={delays[index]}
          class:list={[
            'border-line border-t py-8 md:pr-8',
            index > 0 && 'md:border-l md:pl-8',
          ]}
        >
          <MonoLabel>{step.label}</MonoLabel>
          <h3 class="text-ink mt-4 text-xl leading-tight font-medium tracking-[-0.01em]">
            {step.title}
          </h3>
          <p class="text-ink-soft mt-3 max-w-sm">{step.text}</p>
        </li>
      ))}
    </ol>
  </Container>
</section>
