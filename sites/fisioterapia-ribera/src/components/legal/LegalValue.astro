---
// These templates support compliance and are not legal advice. See texts.ts.
// A value, or the visible pending-review marker when the brief does not have it.
interface Props {
  value: string;
  /** Dotted field name in legal.json, for example `holder.taxId`. */
  field: string;
  pending: string;
}
const { value, field, pending } = Astro.props;
---

{value ? (
  value
) : (
  <mark data-legal-pending={field}>
    {pending}: {field}
  </mark>
)}
