---
import Photo from '../Photo.astro';
import photoLight from '../../assets/images/pausa-luz.jpg';
---

<section class="border-line border-t" aria-label="Pausa">
  <figure>
    <Photo
      src={photoLight}
      alt="Habitación vacía con suelo de madera oscura, paredes blancas y dos ventanas por las que entra el sol."
      ratio="21 / 9"
      position="50% 40%"
      class="pausa-frame"
      sizes="100vw"
      widths={[800, 1280, 1920]}
    />
    <figcaption class="wrap grid grid-cols-12 gap-x-4 gap-y-3 py-6 md:gap-x-6 md:py-10">
      <span class="text-ink-soft col-span-12 text-sm md:col-span-3">
        Una habitación vacía al terminar la obra. Imagen de archivo.
      </span>
      <span class="font-display col-span-12 max-w-[30ch] text-2xl leading-snug font-medium text-balance md:col-span-9">
        La luz es el último material que se coloca.
      </span>
    </figcaption>
  </figure>
</section>

<style>
  .pausa-frame {
    min-height: 18rem;
    max-height: 80svh;
  }
</style>
