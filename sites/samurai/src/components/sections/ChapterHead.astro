---
interface Props {
  /** Roman numeral, "I" to "V". */
  numeral: string;
  eyebrow: string;
  title: string;
  /** Section id of the heading (aria-labelledby target). */
  id: string;
}

const { numeral, eyebrow, title, id } = Astro.props;
---

<header class="grid gap-x-8 md:grid-cols-12">
  <p
    aria-hidden="true"
    data-reveal
    class="font-display text-primary text-numeral leading-[0.9] font-light tracking-[-0.02em] md:col-span-5"
  >
    {numeral}
  </p>
  <div class="mt-4 md:col-span-7 md:mt-0 md:self-end">
    <p
      data-reveal
      class="text-ink-soft text-xs font-medium tracking-[0.2em] uppercase"
    >
      {eyebrow}
    </p>
    <h2
      id={id}
      data-reveal
      data-reveal-delay="0.1"
      class="font-display mt-2 text-3xl leading-[1.05] font-normal tracking-[-0.02em] text-balance"
    >
      {title}
    </h2>
    <div data-reveal data-reveal-delay="0.2" class="mt-6 max-w-[62ch]">
      <slot />
    </div>
  </div>
</header>
