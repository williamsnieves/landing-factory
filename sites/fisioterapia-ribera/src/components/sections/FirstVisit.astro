---
// How a visit works (#primera-visita), the Story and solution stage, on the sand field: the statement, then the thread
// drawn through the four parts of the first visit the brief names (horizontal from 768 px, vertical on phones), ending
// in the exercise plan for home. It shows order only, never minutes or results.
import Thread from '../ui/Thread.astro';
import { firstVisit } from '../../content/site';
---

<section
  id="primera-visita"
  class="bg-field-sand relative overflow-clip"
  aria-labelledby="primera-visita-title"
>
  <div class="mx-auto max-w-7xl px-4 py-28 md:px-8 md:py-44 xl:px-16">
    <h2
      id="primera-visita-title"
      data-reveal
      data-reveal-y="48"
      class="font-display text-ink max-w-[11em] text-5xl leading-[1.04] font-normal tracking-[-0.02em] text-balance"
    >
      {firstVisit.statement}
    </h2>
    <p class="text-ink mt-10 max-w-xl text-lg md:mt-14">{firstVisit.intro}</p>
    <div class="relative mt-14 md:mt-20">
      <Thread
        class="text-primary absolute inset-x-0 top-0 hidden h-12 w-full md:block"
        viewBox="0 0 1000 60"
        preserveAspectRatio="none"
        d="M0 36 C60 20 95 30 125 30 C210 30 290 46 375 30 C460 14 540 30 625 30 C710 30 790 46 875 30 C930 20 970 30 1000 26"
      />
      <ol class="grid gap-0 md:grid-cols-4 md:gap-8">
        {firstVisit.steps.map((step, index) => (
          <li
            data-reveal
            data-reveal-delay={(index * 0.1).toFixed(1)}
            class="border-primary relative border-l-[3px] pb-12 pl-8 md:border-l-0 md:pt-20 md:pb-0 md:pl-0 md:text-center"
          >
            <span
              class="bg-accent rounded-pill absolute top-1 -left-[9px] size-4 md:top-6 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2"
              aria-hidden="true"
            />
            <h3 class="text-ink text-lg leading-snug font-semibold">
              {step.name}
            </h3>
            <p class="text-ink mt-2 text-base leading-relaxed md:mx-auto md:max-w-[16rem]">
              {step.text}
            </p>
          </li>
        ))}
      </ol>
    </div>
    <p
      data-reveal
      class="font-display text-primary mt-4 text-4xl leading-[1.08] tracking-[-0.02em] md:mt-24 md:max-w-[14em]"
    >
      {firstVisit.ending}
    </p>
  </div>
</section>
