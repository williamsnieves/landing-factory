---
// Hero of direction "c": a full-bleed photo of a Valencia street (cropped in CSS to the balconies, see
// .c-hero-photo in c.css) with the headline and the WhatsApp action on a solid paper panel, so text contrast
// never depends on the photo. On small screens the photo sits on top and the panel overlaps its lower edge.
import { Image } from 'astro:assets';
import { site } from '../../../content/site';
import photo from '../../../assets/images/c-balcons-valldigna.jpg';
import SampleTag from './SampleTag.astro';
import { hero } from './copy';
---

<section id="c-hero" class="relative overflow-hidden">
  <div class="relative h-80 overflow-hidden sm:h-96 lg:absolute lg:inset-0 lg:h-auto">
    <Image
      src={photo}
      alt={hero.photoAlt}
      widths={[720, 1080, 1440, 1920]}
      sizes="185vw"
      format="webp"
      quality={58}
      loading="eager"
      fetchpriority="high"
      class="c-hero-photo"
    />
    <p class="bg-paper text-ink absolute top-3 right-3 rounded-sm px-2 py-1 text-xs lg:top-auto lg:bottom-4">
      {hero.photoCaption}
    </p>
  </div>
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:flex lg:min-h-160 lg:items-center lg:py-20">
    <div class="bg-paper border-accent relative -mt-16 rounded-lg border-t-4 p-6 shadow-sm sm:p-8 lg:mt-0 lg:max-w-xl lg:p-10">
      <p class="text-ink-soft text-sm font-semibold">{hero.eyebrow}</p>
      <h1 class="font-display mt-3 text-3xl leading-tight text-balance">
        {hero.title}
      </h1>
      <p class="text-ink-soft mt-4 text-base leading-relaxed sm:text-lg">
        {hero.lead}
      </p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <a
          href={site.primary.href}
          class="bg-primary text-primary-contrast hover:bg-ink rounded-md px-5 py-3.5 text-center text-base font-bold transition-colors"
        >
          {site.primary.label}
        </a>
        <p class="text-sm">
          {hero.callPrefix}{' '}
          <a
            href={site.secondary.href}
            class="font-bold whitespace-nowrap underline underline-offset-4 hover:no-underline"
          >
            {site.contact.phone}
          </a>
        </p>
      </div>
      <p class="text-ink-soft mt-4 flex flex-wrap items-center gap-2 text-xs">
        <SampleTag />
        <span>{hero.contactNote}</span>
      </p>
    </div>
  </div>
</section>
