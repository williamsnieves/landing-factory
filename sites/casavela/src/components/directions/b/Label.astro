---
// Monospaced label of direction "b": small capitals for indexes, sources and metadata.
interface Props {
  as?: 'p' | 'span';
  class?: string;
}

const { as: Tag = 'p', class: extra = '' } = Astro.props;
---

<Tag
  class:list={['font-mono text-xs leading-snug tracking-wide uppercase', extra]}
>
  <slot />
</Tag>
