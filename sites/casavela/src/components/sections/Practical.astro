---
// Practical strip (warm-local-service's practical-strip, kept from direction c by the owner's notes): where, when
// and how to reach the agency in three framed cells, pulled up so it overlaps the photo band's lower edge. The
// sample tag sits in the strip's title row, never in a cell that holds a value.
import { practical } from '../../content/page';
import { site } from '../../content/site';
import SampleTag from '../ui/SampleTag.astro';
---

<section
  id="practico"
  aria-labelledby="practico-titulo"
  class="relative -mt-20 px-4 sm:-mt-24 sm:px-6"
>
  <div class="mx-auto max-w-6xl">
    <div
      class="bg-surface border-line rounded-md border"
      data-reveal
      data-reveal-y="24"
    >
      <div class="border-line flex flex-wrap items-center justify-between gap-3 border-b px-5 py-4 sm:px-6">
        <h2 id="practico-titulo" class="text-xl font-semibold tracking-tight">
          {practical.title}
        </h2>
        <SampleTag note={practical.note} />
      </div>
      <ul class="grid md:grid-cols-3">
        <li class="border-line border-b p-5 sm:p-6 md:border-r md:border-b-0">
          <h3 class="text-ink-soft text-sm font-medium">
            {practical.where.label}
          </h3>
          <p class="mt-2 text-lg leading-snug font-semibold">
            {site.contact.address}
          </p>
          <p class="mt-3 text-sm font-medium">
            <a
              href={site.contact.mapHref}
              class="text-primary underline underline-offset-4 hover:no-underline"
            >
              {practical.where.mapLabel}
            </a>
          </p>
        </li>
        <li class="border-line border-b p-5 sm:p-6 md:border-r md:border-b-0">
          <h3 class="text-ink-soft text-sm font-medium">
            {practical.when.label}
          </h3>
          <p class="mt-2 text-lg leading-snug font-semibold">
            {site.contact.hours}
          </p>
        </li>
        <li class="p-5 sm:p-6">
          <h3 class="text-ink-soft text-sm font-medium">
            {practical.how.label}
          </h3>
          <p class="mt-2 text-lg leading-snug font-semibold tabular-nums">
            {site.contact.phone}
          </p>
          <p class="mt-1 text-base">{site.contact.email}</p>
          <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm font-medium">
            <a
              href={site.primary.href}
              class="text-primary underline underline-offset-4 hover:no-underline"
            >
              {practical.how.whatsapp}
            </a>
            <a
              href={site.contact.phoneHref}
              class="text-primary underline underline-offset-4 hover:no-underline"
            >
              {practical.how.call}
            </a>
          </p>
        </li>
      </ul>
    </div>
  </div>
</section>
