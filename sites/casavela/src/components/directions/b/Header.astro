---
// Header of direction "b": an inverted notice bar (draft and sample notices), then a plain ruled bar with the name
// in the label face, bare text links and a rectangular action.
import { site } from '../../../content/site';
import Label from './Label.astro';
import { header } from './copy';
---

<div class="bg-ink text-paper px-4 sm:px-6">
  <div class="mx-auto max-w-7xl py-2">
    <Label>
      <strong class="font-bold">{site.draftNotice}</strong>{' '}
      <span class="block sm:inline">{site.sampleNotice}</span>
    </Label>
  </div>
</div>
<header class="border-line border-b-2 px-4 sm:px-6">
  <div class="border-line mx-auto flex max-w-7xl items-stretch justify-between border-x">
    <p class="flex min-w-0 items-center px-4 py-4 font-mono text-sm leading-tight font-bold tracking-wide uppercase sm:px-6">
      {site.name}
    </p>
    <nav aria-label="Secciones" class="hidden items-stretch md:flex">
      {header.nav.map((link) => (
        <a
          href={link.href}
          class="border-line hover:bg-ink hover:text-paper flex items-center border-l px-6 font-mono text-xs tracking-wide uppercase underline-offset-4 hover:underline"
        >
          {link.label}
        </a>
      ))}
    </nav>
    <a
      href={site.primary.href}
      class="bg-primary text-primary-contrast border-line hover:bg-ink hover:text-paper flex shrink-0 items-center border-l px-4 text-sm font-semibold sm:px-6"
    >
      {header.cta}
    </a>
  </div>
</header>
