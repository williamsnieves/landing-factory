---
import { Image } from 'astro:assets';
import brandMark from '../../assets/images/logo.webp';
import credits from '../../data/credits.json';
import {
  BUSINESS,
  COUPON_END,
  PRIMARY,
  SECONDARY,
  SOCIAL,
} from '../../data/catalog';

type Credit = { author?: string; license?: string; url?: string };
const entries = credits as Credit[];
---

<footer id="stores" class="footer">
  <div class="wrap">
    <div class="cols">
      <div class="brand">
        <Image
          src={brandMark}
          alt={`${BUSINESS} brand mark`}
          width={96}
          height={96}
          densities={[1, 2]}
          class="foot-img"
        />
        <p>Fast, direct digital products about technology, mostly AI.</p>
      </div>
      <nav aria-label="Stores and social">
        <ul class="links">
          <li>
            <a href={PRIMARY.url} target="_blank" rel="noopener noreferrer">
              Etsy shop
            </a>
          </li>
          <li>
            <a href={SECONDARY.url} target="_blank" rel="noopener noreferrer">
              {SECONDARY.label}
            </a>
          </li>
          {SOCIAL.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer">
                {s.network}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <p class="legal">
      The brand mark and every product cover belong to {BUSINESS}.
      {entries.map((c) => (
        <span>
          {c.author} ({c.license}).
        </span>
      ))}{' '}
      &copy; 2026 {BUSINESS}. Coupon codes end on {COUPON_END}.
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 3rem 2rem;
    border-top: 1px solid var(--color-line);
    scroll-margin-top: 4rem;
  }
  .cols {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  .brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .brand p {
    margin: 0;
    max-width: 18rem;
    color: var(--color-ink-soft);
  }
  .brand :global(.foot-img) {
    display: block;
    flex: none;
    width: 6rem;
    height: 6rem;
    border-radius: var(--radius-md);
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    text-underline-offset: 0.25em;
  }
  .links a:hover {
    color: var(--color-accent);
  }
  .legal {
    margin: 2.5rem 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }
  @media (min-width: 768px) {
    .cols {
      grid-template-columns: 1fr auto;
      gap: 2.5rem;
    }
  }
</style>
