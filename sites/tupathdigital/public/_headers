# Cloudflare Pages headers (copied to dist/_headers by the build).
# Hashed build assets never change, so cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Basic hardening for every response. Only frame-ancestors is set in the CSP
# so GSAP/Lenis and inline scripts keep working.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
