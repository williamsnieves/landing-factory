---
/**
 * Una sesión, 50 minutos (PAS: Agitate -> Solution; the twist of the archetype blend). The heading sits in a sticky
 * label column (CSS `position: sticky`, not a pin) beside the text; below, the 50-minute ruler runs across all twelve
 * columns with a tick per minute, and the four stages of a session hang from it in 3-column cells. The ruler gives
 * the length of the whole session only: no minutes are assigned to a stage (the brief gives none).
 *
 * Motion: the ruler is drawn in five 10-minute segments revealed left to right (opacity only), then the stages
 * appear in order. Under reduced motion or without JavaScript everything is shown at rest, fully drawn.
 */
import Ruler from '../ui/Ruler.astro';
import { session } from '../../data/site';

const segmentCount = 5;
const stageDelay = (index: number) => String(0.6 + index * 0.15);
---

<section
  id="sesion"
  aria-labelledby="sesion-titulo"
  class="border-line border-t py-16 md:py-24"
>
  <div class="wrap">
    <div class="grid-12 gap-y-6">
      <div class="col-span-12 md:col-span-3">
        <h2
          id="sesion-titulo"
          class="text-xl leading-tight font-semibold md:sticky md:top-28"
        >
          {session.heading}
        </h2>
      </div>
      <div class="col-span-12 md:col-span-9 lg:col-span-7">
        <p class="text-lg" data-reveal>
          {session.agitate}
        </p>
        <p
          class="mt-6 text-lg font-semibold"
          data-reveal
          data-reveal-delay="0.1"
        >
          {session.solution}
        </p>
      </div>
    </div>

    <figure class="mt-16 md:mt-24">
      <Ruler
        label={session.rulerLabel}
        minutes={session.minutes}
        segments={segmentCount}
      />
      <ol class="grid-12 mt-2 gap-y-8">
        {session.stages.map((stage, index) => (
          <li
            class="border-primary col-span-12 border-l-2 pt-6 pl-4 sm:col-span-6 lg:col-span-3"
            data-reveal
            data-reveal-y="16"
            data-reveal-delay={stageDelay(index)}
          >
            <h3 class="text-lg leading-snug font-semibold">{stage.title}</h3>
            <p class="mt-2 max-w-[36ch] text-base">{stage.text}</p>
          </li>
        ))}
      </ol>
      <figcaption class="text-ink-soft mt-10 max-w-[60ch] text-sm">
        {session.rulerNote}
      </figcaption>
    </figure>

    <div class="grid-12 mt-12">
      <p
        class="border-line col-span-12 border-t pt-8 text-xl leading-snug font-semibold md:col-span-9 md:col-start-4"
        data-reveal
      >
        {session.closing}
      </p>
    </div>
  </div>
</section>
