---
// Deliverable chips (the `spec-chips` trait lent by bento-product-showcase): small filled pills, sentence case.
interface Props {
  items: readonly string[];
  /** `dark` on paper bands, `light` on bone bands. */
  tone?: 'dark' | 'light';
  label: string;
  class?: string;
}

const { items, tone = 'light', label, class: className } = Astro.props;
---

<ul
  aria-label={label}
  class:list={['m-0 flex list-none flex-wrap gap-2 p-0', className]}
>
  {items.map((item) => (
    <li
      class:list={[
        'rounded-pill px-3.5 py-1.5 text-xs font-medium',
        tone === 'dark'
          ? 'bg-surface text-ink'
          : 'bg-bone-surface text-bone-ink',
      ]}
    >
      {item}
    </li>
  ))}
</ul>
