---
/**
 * Footer, two blocks: the name and one line on the left; on the right one navigation whose rows (Producto,
 * Planes, Contacto) read like the lines of an appointment book: a small label, then the links in a row. The
 * demo note sits in its own paragraph, apart from every fact (plan names, links, email).
 */
import Container from '../ui/Container.astro';
import { brand, footer, nav } from '../../content/site';
import { plans } from '../../data/plans';

const linkClass =
  'text-ink-soft hover:text-primary transition-colors duration-150';
const rowClass = 'border-line border-t py-4';
const labelClass = 'text-ink-muted font-mono text-xs';
const listClass = 'mt-2 flex flex-wrap gap-x-6 gap-y-2 text-sm';
---

<footer class="border-line border-t">
  <Container class="py-14 md:py-20">
    <div class="grid gap-10 md:grid-cols-12 md:gap-x-8">
      <div class="md:col-span-4">
        <p class="text-ink text-lg font-semibold tracking-[-0.02em]">
          {brand.name}
        </p>
        <p class="text-ink-soft mt-3 max-w-xs text-sm">{footer.tagline}</p>
      </div>
      <nav aria-label={footer.label} class="md:col-span-7 md:col-start-6">
        <div class={rowClass}>
          <p class={labelClass}>{footer.columns.product}</p>
          <ul class={listClass}>
            {nav.map((link) => (
              <li>
                <a href={link.href} class={linkClass}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class={rowClass}>
          <p class={labelClass}>{footer.columns.plans}</p>
          <ul class={listClass}>
            {plans.map((plan) => (
              <li>
                <a href={plan.url} class={linkClass}>
                  {plan.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class:list={[rowClass, 'border-b']}>
          <p class={labelClass}>{footer.columns.contact}</p>
          <ul class={listClass}>
            <li>
              <a href={`mailto:${brand.email}`} class={linkClass}>
                {brand.email}
              </a>
            </li>
          </ul>
        </div>
      </nav>
    </div>
    <p class="text-ink-muted mt-14 text-xs">{footer.demoNote}</p>
  </Container>
</footer>
