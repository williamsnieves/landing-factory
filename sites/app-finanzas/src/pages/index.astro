---
import BaseLayout from '../layouts/BaseLayout.astro';
import Motion from '../components/motion/Motion.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import Features from '../components/sections/Features.astro';
import Steps from '../components/sections/Steps.astro';
import Analysis from '../components/sections/Analysis.astro';
import Privacy from '../components/sections/Privacy.astro';
import Plans from '../components/sections/Plans.astro';
import Faq from '../components/sections/Faq.astro';
import Download from '../components/sections/Download.astro';
import Footer from '../components/sections/Footer.astro';

const title = 'Trazo: presupuestos, objetivos y gastos en una app';
const description =
  'Trazo ordena tus gastos en presupuestos, te ayuda a apartar para tus objetivos y te muestra en qué se va cada euro. Descarga la app (página de ejemplo).';
---

<BaseLayout title={title} description={description} lang="es">
  <Motion slot="head" />
  <Header slot="header" />
  <Hero />
  <Features />
  <Steps />
  <Analysis />
  <Privacy />
  <Plans />
  <Faq />
  <Download />
  <Footer slot="footer" />
</BaseLayout>
